})()),dehydratedQueryClient:$R[23]={mutations:$R[24]=[],queries:$R[25]=[$R[26]={dehydratedAt:1790612129842,state:$R[27]={data:null,dataUpdateCount:1,dataUpdatedAt:1790612129803,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[28]=["session"],queryHash:"[\"session\"]"},$R[29]={dehydratedAt:1790612129842,state:$R[30]={data:$R[31]={mode:"system"},dataUpdateCount:1,dataUpdatedAt:1790612129803,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[32]=["themePreference"],queryHash:"[\"themePreference\"]"},$R[33]={dehydratedAt:1790612129842,state:$R[34]={data:$R[35]={category:$R[36]={id:"apps/bluesky",label:"Bluesky",description:"Bluesky apps and ecosystem tools.",accent:"blue",count:164,depth:1,pathIds:$R[37]=["apps","bluesky"],pathLabels:$R[38]=["Apps","Bluesky"],children:$R[39]=[$R[40]={id:"apps/bluesky/client",label:"Client",description:"Client tools within Bluesky.",accent:"green",count:51,depth:2,pathIds:$R[41]=["apps","bluesky","client"],pathLabels:$R[42]=["Apps","Bluesky","Client"],children:$R[43]=[]},$R[44]={id:"apps/bluesky/tool",label:"Tool",description:"Tool tools within Bluesky.",accent:"green",count:49,depth:2,pathIds:$R[45]=["apps","bluesky","tool"],pathLabels:$R[46]=["Apps","Bluesky","Tool"],children:$R[47]=[]},$R[48]={id:"apps/bluesky/analytics",label:"Analytics",description:"Analytics tools within Bluesky.",accent:"green",count:31,depth:2,pathIds:$R[49]=["apps","bluesky","analytics"],pathLabels:$R[50]=["Apps","Bluesky","Analytics"],children:$R[51]=[]},$R[52]={id:"apps/bluesky/scheduling",label:"Scheduling",description:"Scheduling tools within Bluesky.",accent:"green",count:20,depth:2,pathIds:$R[53]=["apps","bluesky","scheduling"],pathLabels:$R[54]=["Apps","Bluesky","Scheduling"],children:$R[55]=[]},$R[56]={id:"apps/bluesky/feed-generators",label:"Feed Generators",description:"Feed Generators tools within Bluesky.",accent:"green",count:7,depth:2,pathIds:$R[57]=["apps","bluesky","feed-generators"],pathLabels:$R[58]=["Apps","Bluesky","Feed Generators"],children:$R[59]=[]},$R[60]={id:"apps/bluesky/moderation",label:"Moderation",description:"Moderation tools within Bluesky.",accent:"green",count:3,depth:2,pathIds:$R[61]=["apps","bluesky","moderation"],pathLabels:$R[62]=["Apps","Bluesky","Moderation"],children:$R[63]=[]}]},listings:$R[64]=[$R[65]={id:"f1493c7c-34f6-4610-bf05-4d718b7ff162",name:"Graze",slug:"graze",tagline:"Build custom social feeds. Grow your audience. Keep the revenue. No code required.",description:"We equip developers with the tools to do more, enfranchise curators to shape their communities, and empower brands to own their algorithms. Graze is committed to fostering an open web that prioritizes people, creativity, and authenticity. We're putting the power back into the hands of those who shape it.\n\nStop letting platforms control your reach. Graze lets you create personalized feeds on ATProto — no code required.\n\n- Easily build feeds with a visual editor and powerful logic\n- Real-time filtered streams for developers\n- Subscriber-only content spaces with Patreon integration\n- Operators can connect directly with advertisers to discuss campaigns on Graze",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:i6y3jdklpvkjvynvsrnqfdoq/bafkreidvmshmpy6tynmaxfz5wfhufn2zuapxielsezza3ecsgoshlmd5we@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:i6y3jdklpvkjvynvsrnqfdoq/bafkreic5krilamk3n7u6h2adtyigi55pahdwdh47agkhywkqj47mgrx5m4@png",categorySlugs:$R[66]=["apps/bluesky/feed-generators"],categorySlug:"apps/bluesky/feed-generators",category:"Bluesky Feed Generators",accent:"green",rating:5,reviewCount:9,priceLabel:"GET",productAccountHandle:"graze.social",appTags:$R[67]=[]},$R[68]={id:"ebf6a12f-f1a2-4af6-be50-a1401035a7ca",name:"Boost Blue",slug:"boost-blue",tagline:"Boost your Bluesky experience",description:"Boost Blue is an alternative Bluesky app that supports iPhone, iPad, and Android, that boosts your Bluesky experience with a streamlined UI and additional features:\n\nPreserved Feed Position - Always start where you left off in your following feed and lists.\nDrafts – Save posts for later, perfect for work-in-progress thoughts or planning a thread.\nMute Reposts by User - Silence reposts from accounts that clutter your view.\nAdvanced Feed Controls - A toolbox of filters to create your perfect Bluesky experience.\nStreamlined UI - Unnecessary UI automatically hides as you scroll.\nCustomization - Change which pages appear in your bottom Tab Bar.\nIn App Translations - See what posts in other languages say without leaving the app.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:e5sycehmo2p3ze6qvrrsurcc/bafkreicnh6vxf36wxm7lbt6wsyiii3tjvlissupu63leeqloojznxgaf7e@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:e5sycehmo2p3ze6qvrrsurcc/bafkreigoblvzej4tpuxixr6ohwsefjbwy3yvmtu6ihpze5pmkjmunszige@png",categorySlugs:$R[69]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:5,reviewCount:6,priceLabel:"GET",productAccountHandle:"boostblue.bsky.social",appTags:$R[70]=[]},$R[71]={id:"49f34322-3e04-4569-8f85-a19ac4e19aab",name:"Skywalker",slug:"skywalker",tagline:"3rd party Android client for Bluesky",description:"3rd party Bluesky client for Android (phones, tablets, chromebook). It supports all Bluesky feature and offers many additional features for free: various options for composing post threads, in-app thread reader, add embedded links to your post, in-app meme generator, mute reposts per user, multiple levels of content filtering (global, per list), find out which posts were filtered from your feeds, focus hashtags, gallery view for photos and video feeds, full screen swipe mode for photos and video feeds, interact to a post with any account if you have multiple accounts.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:zzmeflm2wzrrgcaam6bw3kaf/bafkreifkxggks3kcvu3pcawhu5n2u5ocuhwashulo6vkdq5pha7odend2a@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:zzmeflm2wzrrgcaam6bw3kaf/bafkreiczc6utjtfamentiix6m3olx3eyqtrfh3keldo5xj44d6s2ckev5y@png",categorySlugs:$R[72]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:4.8,reviewCount:6,priceLabel:"GET",productAccountHandle:"skywalker.thereforeiam.eu",appTags:$R[73]=[]},$R[74]={id:"98ec8676-3c8f-434a-b166-69c9555c0044",name:"favs.blue",slug:"favs-blue",tagline:"See any Bluesky account's most popular posts.",description:"favs.blue shows you the top posts from any Bluesky user -- like favstar.fm, but for Bluesky!",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:zezz2wl7z2q6rvm4qtcp7aig/bafkreici6rmip75b6owzsr45z4wjsbeoxhfrs63rei67d6upgi6rlxnt4m@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:zezz2wl7z2q6rvm4qtcp7aig/bafkreif6uvl62hdzerx7szkpztd7nyvbnt4kdzhsbai5lpqvro2v7wz3ne@png",categorySlugs:$R[75]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:5,reviewCount:2,priceLabel:"GET",productAccountHandle:"favs.blue",appTags:$R[76]=[]},$R[77]={id:"80cd211e-ae85-4bf8-8c52-1431b50b3bca",name:"Tracker - Manager for Bluesky",slug:"bluesky-tracker-manager",tagline:"Track & Manage in real time your network. The must have companion app for Bluesky.",description:"Looking for the best tool to track and manage your Bluesky followers & unfollowers in real time?\n\nTracker - Manager for Bluesky makes it easy to monitor your audience, manage connections, analyze your posts and grow your network on Bluesky.\n\n✨ Key Features\n✅ Track Followers & Unfollowers: Instantly see when someone follows or unfollows you in real time.\n✅ Blocked by & Blocking Lists: See who has blocked you and who you've blocked so you can manage connections effectively.\n✅ Advanced Filters: Filter users in your Bluesky network based on keywords, follower count, follower to following ratio, activity level, timeline and engagement for better targeting and analysis.\n✅ Bulk Follow & Unfollow: Easily follow or unfollow users in bulk - great for cleaning up or growing your network.\n✅ Fix Followings: Automatically remove deleted, suspended, or blocked accounts to correct the inaccurate following counts of Bluesky.\n✅ Likes Timeline: See posts liked by any user, including yourself, to explore interests and engagement patterns.\n✅ Posts Tracking & Sorting: Browse any user's posts and sort by likes, reposts, replies, quotes, or date to highlight key content.\n✅ Post Stats & Analytics: Access detailed post metrics for any user, including reach, replies, reposts, and likes over time.\n✅ Profile Actions: Follow, unfollow, block, or unblock users directly from their profile. Add private labels for better organization.\n✅ Relationship History: See when you followed someone - and when they followed you on Bluesky.\n✅ Handle History: Check past usernames for any account to verify identity and name changes.\n✅ Mutual Connections Insights: See who follows you back to strengthen key connections.\n✅ Track, Filter and Follow user's Followers or Followings: Expand your network by following another user’s audience with one tap.User-Friendly and Secure\n✅ User-Friendly Interface: Clean and easy interface to manage your Bluesky network. Navigate effortlessly and access key information at a glance.\n✅ Privacy First: Your data is never stored or shared. Everything stays secure and on your device.\n\nWhether you're an influencer, content creator, or a casual user, Tracker - Manager for Bluesky is your all-in-one companion for tracking, managing, and growing your Bluesky social network.Manage your Bluesky followers, find everyone's follower to following ratio and analyze posts - faster than ever.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:qic76y2rz6hog4ashqm5kvwp/bafkreihnn6yleenvq7icb667nglhwlgh5yzcm6l7ljqkmergbm3c5afxay@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:qic76y2rz6hog4ashqm5kvwp/bafkreibpsdr6li36v7boyekg4feijbqdqb5c2vgxuo7wt6auuoqlz6msie@png",categorySlugs:$R[78]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:5,reviewCount:2,priceLabel:"GET",productAccountHandle:"blueskytracker.app",appTags:$R[79]=[]},$R[80]={id:"58311a86-bf6b-470a-aba6-f95b5f49e5bb",name:"Skeets",slug:"skeets",tagline:"3rd party iOS / iPad OS client for Bluesky",description:"The app offers a truly native look & feel that makes iOS & iPad OS users feel right at home. It has been optimised for accessibility and is continuously being improved to offer users a Bluesky experience without barriers.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieuew7vfhq7hmmbj3fx3wahqhmqu37u6q5ut6f4klgjhasavz6gnu@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihz5g4lgfd7udcxmcbu2jgrhjk3pmo7z24zuccboj6d6tsge52b7m@png",categorySlugs:$R[81]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:5,reviewCount:2,priceLabel:"GET",productAccountHandle:"skeetsapp.com",appTags:$R[82]=[]},$R[83]={id:"34cc9857-c21f-4d1b-ab44-a751d4421310",name:"Flux",slug:"flux",tagline:"A calm, beautiful Bluesky client app for iOS",description:"A beautiful, customizable Bluesky client made for you. Swipe between feeds, send DMs, and make it yours with themes and a clean liquid glass interface.Your new favorite way to enjoy Bluesky, made with care and attention to detail.Flux is a beautifully crafted Bluesky client that puts you in control. Switch between your favorite feeds with a single swipe, stay connected with full direct messaging support, and personalize every detail to match your style.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:tgqpjtx2hoixdrlvbujlt2f7/bafkreidin4lmoka63j76vyz7ywvfbrfgi5miv34jk4iducxrni3jd4qkjy@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:tgqpjtx2hoixdrlvbujlt2f7/bafkreibi5c4qs7wwprirogf5jukjyizqo2u427xfiuiptmjqjn323rctgu@png",categorySlugs:$R[84]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:5,reviewCount:2,priceLabel:"GET",productAccountHandle:"fluxapp.blue",appTags:$R[85]=[]},$R[86]={id:"8f5a0e57-91f4-446d-9b30-7bb61ed3a089",name:"Bluesky",slug:"bluesky",tagline:"Social media as it should be. Find your community among millions of users, unleash your creativity, and have some fun again.",description:"The flagship microblogging social network built on AT Protocol for posting, following, and discovering conversations.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid47n5hlxezntc7inyj7asg6rwqtf32m7zj67mbg53r4vjx7qyka4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreia5vahxq34okwdpicef5yjo5iekkb6utkxkzntfrqqfi6xbwb53lu@png",categorySlugs:$R[87]=["apps/bluesky"],categorySlug:"apps/bluesky",category:"Bluesky",accent:"blue",rating:4.4,reviewCount:11,priceLabel:"GET",productAccountHandle:"bsky.app",appTags:$R[88]=["social"]},$R[89]={id:"254348fb-26d7-45b3-a26e-ade7812a9324",name:"Dopplersky",slug:"dopplersky",tagline:"Bluesky analytics that go past the follower count",description:"Dopplersky is analytics for Bluesky. Look up any public handle for its daily follower and engagement history and see every post ranked by how it actually performed. No login required to look at a public profile, and signing in with Bluesky turns it into your own dashboard.\n\nPremium adds the depth: a full replay of how each post took off hour by hour, audience intelligence showing who engages and when, the repeat engagers who never followed you, side by side comparison of any two accounts, and a virality ranking across everything you have published. Premium is $20/month after a 7-day free trial with no credit card.\n\nBuilt on the AT Protocol, so it works with any app on the network.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:xlmpg6bnrhaqr26vtjoodl4y/bafkreid7aq7rcs2ryu447puiregdq5nuvwgravqlwjughvg35btbt6iqby@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:xlmpg6bnrhaqr26vtjoodl4y/bafkreiglv3w5jkxxcl4l4jmml36hgty7r6bvwmwjcuhhkofh2qkhlmpfvm@png",categorySlugs:$R[90]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:5,reviewCount:1,priceLabel:"GET",productAccountHandle:"dopplersky.com",appTags:$R[91]=[]},$R[92]={id:"52a945b4-3a9e-48bd-9a50-832a8e765832",name:"Skyscraper for Bluesky",slug:"skyscraper-for-bluesky",tagline:"A new native and Liquid Glass designed client for iPhone and iPad.",description:"Skyscraper is the Bluesky client that feels like it belongs on your device.Built from the ground up for iOS and iPadOS, Skyscraper is your penthouse view of the Bluesky network. Smooth, fast, and thoughtfully designed to match the way you want an app to feel.The Features You Need:• Full timeline with pinned feeds and custom algorithms• Post with images, videos, GIFs, and alt text• Direct messages and notifications with optional push alerts• Search posts, users, and hashtags• Moderation controls that put you in charge• Profile editing and saved postsPower features that set Skyscraper apart:• Multiple Accounts — Switch between accounts instantly• Post Drafts — Save ideas for later• Account Backup — Export and archive your data• Thread Archival - Share popular threads with friends off Bluesky• Safari Extension — Open bsky.social links directly in Skyscraper• Trending Hashtags — See what's buzzing right now• Unified Timeline — See replies in your following feed• Mute Reposts — Silence repost-happy users without unfollowing• Custom Theme Colors — Make the app fit your personality• Post Translation — Read posts in any languageDownload Skyscraper and get a better view of the Bluesky.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibygfrbe2tr2gcph4modyw3lm63xo4kidsr4kqujw2uycbxcggmn4@png",heroImageUrl:null,categorySlugs:$R[93]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:5,reviewCount:1,priceLabel:"GET",productAccountHandle:"getskyscraper.com",appTags:$R[94]=[]},$R[95]={id:"38e68cc6-321d-488f-b2c2-ccb366c0d70f",name:"Wamellow",slug:"wamellow",tagline:"Get Bluesky posts into Discord, as they happen — with post filters, pings and more",description:"Send new Bluesky posts directly into Discord\n- Up to 100 Bluesky users per server\n- Fully customizable message and embed\n- Dozens of placeholders\n- Notification roles (@everyone, @here, or @some-role)\n- Post filters (Reposts, Replies, Quotes, Must Contain Image; or white-/blacklist regex)\n- Custom Username & Avatar (white labeling)\n\nWamellow allows you to directly like and repost Bluesky posts within Discord!\n- On Bluesky Notifications: Hit the \"like\" or \"repost\" button on the bottom of the message.\n- On every other message: If a message contains a link to a Bluesky post, you can just react with a 🩵 (light blue heart) emoji, to like it on Bluesky.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:jjtrsxiaw4amuujelxrxy7by/bafkreibb5xo5rh2hkzrn4wixo7xuenwyocwypyskmpyd7kdhkvyylmifc4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:jjtrsxiaw4amuujelxrxy7by/bafkreiao4wiqxxedyehjocnl6zwmqpsdkr6qnk77uywn4mhf3xmcxvixze@png",categorySlugs:$R[96]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:5,reviewCount:1,priceLabel:"GET",productAccountHandle:"wamellow.com",appTags:$R[97]=[]},$R[98]={id:"6bd04d3e-b604-454a-bc61-101c64fb1b35",name:"Skyblur",slug:"skyblur",tagline:"Post spoiler-protected Bluesky content with bracket-based blur markup.",description:"Skyblur is an AT Protocol-compatible posting tool for Bluesky that lets you mask spoiler text by wrapping segments in square brackets before publishing. It posts directly to Bluesky with blurred placeholders in-feed while preserving a readable unblurred version in Skyblur, so people can opt in to reveal hidden content.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:4sm3vprfyl55ui3yhjd7w4po/bafkreieo4lv3m6tc4uxwfgdzpmu4t4lmq3a43dqzn6rnudndw4k62zkigq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:4sm3vprfyl55ui3yhjd7w4po/bafkreif5d2hamuk3jnc7eziquokdnmd5bkp2ey47mtjcv6zmk4uirgmrym@jpeg",categorySlugs:$R[99]=["apps/bluesky/moderation"],categorySlug:"apps/bluesky/moderation",category:"Bluesky Moderation",accent:"green",rating:4,reviewCount:1,priceLabel:"GET",productAccountHandle:"skyblur.uk",appTags:$R[100]=[]},$R[101]={id:"855fba99-1cf1-4e61-b74c-587748788a65",name:"Deer",slug:"deer",tagline:"fork of social app with toggles for niche features",description:"Philosophyby default, deer.social should very similar to the official clientcolor and branding are different to distinguish from social-app!no-unauthenticated behavior is differentanalytics are not presentopinionated features behind togglesfocus on high impact, low diff size patchesspecifically patches that won't require large conflicts to be resolvedfocus on power users (but all users are welome!)enable things that are possible but annoying today without egging on antisocial behavior",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibgaf7k5t3dixie7qd6jfwbaffbgxxqmecm5r4i4m7hr5sg7suhme@png",heroImageUrl:null,categorySlugs:$R[102]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:4,reviewCount:1,priceLabel:"GET",productAccountHandle:null,appTags:$R[103]=[]},$R[104]={id:"cde20d67-9539-4794-bfd1-9d8268b727a0",name:"deck.blue",slug:"deck-blue",tagline:"A TweetDeck-like client for Bluesky",description:"Developed by Gildásio deck.blue is a TweetDeck-like client for Bluesky in development since 2023-08-08. deck.blue is built using Flutter, and supported via Patreon.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:w342borqxtyo2pul67ec2pwt/bafkreicdmdbvlq57d2hcpuo2sp6bhjwzxxwczjrjb22sr63vpys6itthcm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:w342borqxtyo2pul67ec2pwt/bafkreifgsf5lbpi5s4wsf7s4xn4ucbfxkrfbntl6aqfmdmf7k4s2wbefye@png",categorySlugs:$R[105]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:4,reviewCount:1,priceLabel:"GET",productAccountHandle:"deck.blue",appTags:$R[106]=[]},$R[107]={id:"500f3fd9-7932-4c7a-ada4-d0eadc098271",name:"bskycheck",slug:"bskycheck",tagline:"Live tracking of new bluesky users",description:"Track Bluesky's expansion with live data. Monitor new handles, verified domains, and user growth trends across multiple metrics.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicogxjme4udb6h6ge4lpmlfiittfwaujawdmel7w3uqd43zeu7ztq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiapodo7hsaagp7fxkgimgbakvj564y6ixlgwhuqxeausj4bvxol7u@png",categorySlugs:$R[108]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:4,reviewCount:1,priceLabel:"GET",productAccountHandle:"bskycheck.com",appTags:$R[109]=[]},$R[110]={id:"be6f0ae9-3f2d-4909-a149-a79b77e007a3",name:"Sky Zoo",slug:"sky-zoo",tagline:"Assigns you a Bluesky animal based on your recent activity,",description:"TIP: If you're viewing a profile on blue sky,\n\nprefix with \"skyzoo.blue/\" to open it here!",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:e6evlmak7xazlp42updjez7x/bafkreict5zlel2orrwbv4uuhao5qivasr72h7izpu2zzphjyrrd2i5pxrm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:e6evlmak7xazlp42updjez7x/bafkreighlpsuv7hw47hgaceqippk62nuesrmah2san63wgsekmtp6cpq7m@png",categorySlugs:$R[111]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skyzoo.blue",appTags:$R[112]=[]},$R[113]={id:"96e4127e-5505-4d59-969d-2337f30ff1bb",name:"OpenVibe",slug:"openvibe",tagline:"Mastodon, Bluesky, Nostr, Threads in ONE app, in ONE feed ✨",description:"Discover a New Era of Social Media: Openvibe offers unified social experience, bringing together your favorite open social networks like Mastodon, Bluesky, Nostr, Threads, and more into a single, seamless timeline. Connect, share, and explore without boundaries.Connect Across Platforms Effortlessly: Post once, reach all. Openvibe makes it simple to share your moments, thoughts, and discoveries across multiple networks, amplifying your voice and expanding your reach.Your Network, Your Control: Empower your online presence. Openvibe places you in charge of your social feed, data, and identity. Customize your experience, safeguard your privacy, and migrate your followers with ease.Be Part of the Open Social Revolution: Join us on Openvibe and experience the future of social networking. Own your content, your network, and your social identity.Features:- Unified timeline of decentralized social networks ( Mastodon Bluesky Nostr Threads )- Cross-platform content sharing- Personalized content discovery- Complete control over your social feed and data- Easy migration of followers across platformsDownload Openvibe now and be the first to join the town square of open social media.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihmmv5uizk2534ttbawqud3vsdbiujrh7jxa53vmlriw3yp72x2ui@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifz7wzcl3c3lr2uuokiucusxeu7vyj3paq2uq73eftanbqnr67zua@png",categorySlugs:$R[114]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"openvibe.social",appTags:$R[115]=[]},$R[116]={id:"41050fd6-b963-4766-909f-381d22f8570d",name:"Deck³",slug:"deck3",tagline:"A client for Bluesky that people who liked Tweetdeck will enjoy. Proably.",description:"You get a column, and you get a column and you get a column! Deck³ imagines what would be like if Tweetdeck still existed but for Bluesky. And goes beyond that, some of the fun features include:\n\n- a time capsule that saves and seals posts for you in the future\n- a reminder to come back to posts in a given amout of time\n- a like tab on every profile\n- an advanced search feature\n- a hidden fun stuff menu with much more.\n\nDeck³ is free and it will always be free. Available for Mac OS, Windows and soon for Linux too.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:mzvfitat32plq3z74wyape4j/bafkreidgrarqd27kvaaaixdcnzv66kyg33f5xuw2ictxsvupsvppjedhia@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:mzvfitat32plq3z74wyape4j/bafkreigok6rievuksylpdrhdb62rx675wou664q7kllqu2segwkpx3vmmu@png",categorySlugs:$R[117]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"deck3.app",appTags:$R[118]=[]},$R[119]={id:"261fa03e-673d-43c4-b622-302c801528a5",name:"Helico",slug:"helico",tagline:"Well Designed Bluesky Client",description:"A client app to enjoy Bluesky more freely.Easy to use for everyone, from beginners to power users.Supports essential features like posting and search, plus multi-column display.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicql5vsvf4xs7dywdbts6iaylt6nbklc5v5sysxlvuob4m7fbyoh4@jpeg",heroImageUrl:null,categorySlugs:$R[120]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"helico.oza.works",appTags:$R[121]=[]},$R[122]={id:"547aee49-45f0-41a9-9f79-247b4893f01b",name:"Bluvy Dex",slug:"dex-bluvy-app",tagline:"See clearly who you follow, and who follows you",description:"Bluvy Dex is a simple tool to manage your Bluesky social connections. Quickly find out who's following you, who you follow back, spot people you've lost track of, and keep your network organized — all in a clean and intuitive interface.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:igeygqy5veq5bv6yz5dtwpi6/bafkreighqzkgxossr4zsa7kr6jq6alrwvcq3lzyt6sbncy32xidhxi677q@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:igeygqy5veq5bv6yz5dtwpi6/bafkreickcmrnnm5q5i5kuhqv3r5nobtkfe44hpxsn4z7ysjtym47nj2enq@png",categorySlugs:$R[123]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"dex.bluvy.app",appTags:$R[124]=[]},$R[125]={id:"cc76a05e-619d-4fcb-9486-a973ad7d2e44",name:"BlueWeave",slug:"bluesky-5",tagline:"One thread woven from Bluesky, Mastodon and X.",description:"Blueweave reads Bluesky, Mastodon and X as a single chronological\nthread. Sign in with your Bluesky account, add the Mastodon and X\naccounts you follow elsewhere, and stop switching apps to keep up.\n\n- Threads are reassembled, including the post a reply answers, so a\nconversation reads top to bottom instead of arriving in pieces\n- Like, repost, reply and post from the feed, with images\n- Save posts from any source: the whole post is stored, so it outlives\nthe instance that served it\n- A deck view puts each source in its own column\n\nNo analytics, no third-party scripts, no advertising, no email address\ncollected.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:hqnyog7skad6m4aejb2yujxy/bafkreihehkjo6apn5xcwuiuh55hkey3rmd5p77eva2m3cery7ertt7jdlu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:hqnyog7skad6m4aejb2yujxy/bafkreigynln5npmh4c4yufu2eutd5gppqnfolu44xrlq7ut72s3xunchty@png",categorySlugs:$R[126]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"une-tasse-de.cafe",appTags:$R[127]=[]},$R[128]={id:"51f95435-8eba-46d7-8267-e625a0d973a9",name:"Skysquare",slug:"skysquare",tagline:"Public conversation, anchored to the web.",description:"Skysquare brings Bluesky conversation directly into the web pages you are reading, so you can read commentary about an article while you read the article itself. It highlights passages people have quoted and shows the connected Bluesky posts alongside the source, letting you compare commentary in context instead of chasing it through detached feeds.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:7dfrk2q5qhd3e7yyel444gam/bafkreih3tih5sxzdzfocgvauktulvzjlhil3fkrdxsdvjd46gfvwcvu6ya@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:7dfrk2q5qhd3e7yyel444gam/bafkreichingraw4ffntxhgdzbtxtxmxgavhahxsox5fjxlxcxckx63pzum@png",categorySlugs:$R[129]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skysquare.app",appTags:$R[130]=[]},$R[131]={id:"9688c1d5-a67b-4810-a4cb-8b87815afeb9",name:"Bluvy Messenger",slug:"bluvy-messenger",tagline:"An end-to-end encrypted messaging app built on AT Protocol.",description:"Bluvy Messenger is an end-to-end encrypted messaging application built on AT Protocol. You can sign in using your Bluesky, Eurosky, or any other compatible account.\nYour messages are encrypted directly on your device before being sent to the server. The server only stores and relays encrypted data and does not have the keys required to read your conversations.\nIn other words, even as the developer of Bluvy, I cannot access your messages. Only the participants in a conversation can decrypt and read them.\nThis first beta release is intentionally simple and currently supports only one-to-one conversations. Its purpose is to validate the core messaging experience, identify potential issues, and gather your feedback before introducing additional features.\nThe servers are hosted in France. No data is shared with third parties, and Bluvy Messenger does not use cookies or tracking technologies.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:nqj7zly655qamncrfgcau3n6/bafkreihpsyqvwlptwageemfygfcelrm7zglbjzuoq4mqpezcqq5pepw76a@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:nqj7zly655qamncrfgcau3n6/bafkreiaficj2yi6bhxddue26p2tpuilyqdte6bj25br4sc7evr5mxnxjqq@png",categorySlugs:$R[132]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bluvy.app",appTags:$R[133]=[]},$R[134]={id:"27cf03fc-175a-4717-9d2c-507a92fab269",name:"Byline.pub",slug:"bluesky-3",tagline:"Books with a byline. Authors with a place.",description:"Byline.pub is an indie author hub and discovery layer for the open social web.\n\nAuthors can create a public profile, list their books, manage author-controlled metadata, and connect their AT Protocol identity to the work they publish. Each author gets a public hub: a simple place for readers to discover their books, follow their work, and find the person behind the byline.\n\nByline is not another social network, bookstore, or walled garden. It is a lightweight author hub and discovery directory for indie publishing: books with a byline, authors with a place.\n\nBuilt on the AT Protocol, Byline is designed for a web where identity, reputation, and creative work can move with the author instead of being locked inside one company’s database.\n\nTop Features:\n- Author Profiles\n- Book Listings\n- Public Author Hubs\n- Verified Author Access\n- AT Protocol Native Records\n- Indie-Focused Discovery\n- Author-Controlled Metadata\n- Simple Book Management\n- Open, Portable, and Future-Friendly",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ppjep63wzgs57unhrdcxqttm/bafkreicbgtlaoa3vccudedt4ranu3m3n7qpjem5oor6q4zv67e36khl5f4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ppjep63wzgs57unhrdcxqttm/bafkreicmovzlifqnshikdg33k7pw5fsdcyo2kzl3oe4ogliu6neg6hhj3a@png",categorySlugs:$R[135]=["apps/bluesky"],categorySlug:"apps/bluesky",category:"Bluesky",accent:"blue",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bylinepub.bsky.social",appTags:$R[136]=["books","publishing"]},$R[137]={id:"aa4fd6ea-823a-4bac-9c03-8a3a817a4250",name:"SkyScheduler",slug:"bluesky-2",tagline:"Schedule and automatically repost on Bluesky! Boost engagement and reach more people no matter what time of day!",description:"SkyScheduler helps you manage your posts on the ATProto atmosphere. No bullshit, no gimmicks, just make your content.\n\n* Free and Open Source! Supports most ATProto PDS instances\n* Schedule your posts any time in the future (to the nearest hour)\n* Supports rich embeds, quote posts, links, tagging, mentions\n* Post media with content labels and full support for alt text\n* Edit the content of posts and alt text before publish\n* Publish entire threads with up to 10 child posts per thread\n* Automatically retweet anything at an interval of your choosing up to 15 times every 240 hours (10 days)\n* (Even content that's wasn't originally made on SkyScheduler!)\n\nMade with love by [@SocksTheWolf](https://socksthewolf.com)",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ecfcvvlqmadysyik3thlbs3c/bafkreidedyzspncx5ez3acxt4hjwysdwty7eibaypfcatyb7boyfndrnqy@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ecfcvvlqmadysyik3thlbs3c/bafkreig5bts46djsosrgbjiwvgfaoivzdir7esu3g64wrkxts4a74xzxci@png",categorySlugs:$R[138]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skyscheduler.work",appTags:$R[139]=[]},$R[140]={id:"61f741e9-af7e-4183-bb1e-3f1e6f8dfa41",name:"Bluefeed",slug:"bluefeed",tagline:"Feed Builder & Viewer for Bluesky.",description:"Bluefeed is a web app for building and viewing custom Bluesky feeds, helping users curate timeline experiences around specific topics and communities.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:7m4jzfe6b5eg5uhf5bb6j2aq/bafkreihlxxgbdom4orlhxehkc2haqcapdk7eo55r3ykvtwp6ct5taxtvyq@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:7m4jzfe6b5eg5uhf5bb6j2aq/bafkreiafpkxitjb7kcuqka2nvkitcvu7rlorfmcq6piuulva2msr6zdqqa@jpeg",categorySlugs:$R[141]=["apps/bluesky/feed-generators"],categorySlug:"apps/bluesky/feed-generators",category:"Bluesky Feed Generators",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bluefeed.app",appTags:$R[142]=[]},$R[143]={id:"d646e00a-6247-4234-9d79-9b0970de8dfe",name:"GlimpSky",slug:"bluesky-4",tagline:"Public Bluesky profile, likes, thread, and follower explorer.",description:"GlimpSky is a lightweight web tool for exploring public Bluesky profiles, likes, followers, following lists, and threads. It supports filters by date, text, author, links, replies and quotes, regex search, profile diagnostics, activity analytics, and public thread inspection. It uses public Bluesky and AT Protocol data only and requires no login.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:xfd6rbdcmbesdjrumyxdlipp/bafkreifxkltjzydunbh5wqge3koigpo7weynndrepfdvmjizptvsokcdb4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:xfd6rbdcmbesdjrumyxdlipp/bafkreidbn3lnmvkqp772iry3jg4e5y3avcyyluhlfmy6ew266asdshzzaa@png",categorySlugs:$R[144]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"oblachek.eu",appTags:$R[145]=[]},$R[146]={id:"082fda1c-0c34-420f-a678-4e8250b3faee",name:"Bluesky List Manager",slug:"bluesky-list-manager",tagline:"Manage and grow your Bluesky lists efficiently",description:"A tool to explore bios and helps find new members to add in your Bluesky lists, based on their bios and handle.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:v4zpi74gy7enfiwke7hmoxv5/bafkreidwdfvlkpnzhc4o4t3igliingq2xu4reu4jc6avivvejyk7pst3s4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:v4zpi74gy7enfiwke7hmoxv5/bafkreibwhamae7j7qfqbflvkdymw6f3byri3gvphlgucb4pd3ksvn6tcka@png",categorySlugs:$R[147]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"pixeline.be",appTags:$R[148]=[]},$R[149]={id:"845b636b-1ca9-4647-abc0-8514f29e78c0",name:"Opal",slug:"opal-2",tagline:"Convert microblog posts from Twitter, Mastodon, Threads, and Nostr to Bluesky",description:"pal is a CLI and library for converting microblog post archives from Twitter/X, Mastodon, Threads, and Nostr into AT Protocol records on Bluesky. Handles automatic thread splitting for posts exceeding the 300-grapheme limit, facet conversion for links and mentions, and batch publishing with original timestamps preserved.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ofrbh253gwicbkc5nktqepol/bafkreidxijnulfaknuj6jtez4d7jgu2ugx37kduyisaidzeajf7czwjvra@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:ofrbh253gwicbkc5nktqepol/bafkreifd3zouttcyu77ak3ncuj5f7qvpauhdxdh7flneullycscapftddm@png",categorySlugs:$R[150]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"ewancroft.uk",appTags:$R[151]=[]},$R[152]={id:"ac76610b-f5b2-4920-8b63-0b1417ff7538",name:"akari",slug:"akari",tagline:"an atproto client",description:"an atproto client",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:qysnzwcpvbhdp2i7t26t3u65/bafkreig2skee6r2pnetlsk3tbj6e3ng3un6iy2x5rprbpmh3zyspahlcvm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:qysnzwcpvbhdp2i7t26t3u65/bafkreifadm7bppisbsn6ya7nkapja6eporie632zkbh4cqhuakdtupizmy@png",categorySlugs:$R[153]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"akari.blue",appTags:$R[154]=[]},$R[155]={id:"04661810-8e90-4b44-91e2-b8b3d9ec2d70",name:"topics.",slug:"topics",tagline:"The heartbeat of the Bluesky community.",description:"topics. is the daily roundup of what's happening on Bluesky. Open it in the morning to see the stories everyone is posting about, from breaking news and pop culture to the recurring community moments that make Bluesky feel like Bluesky.\n\nTop features:\n\nA curated front page. The day's top stories ranked by how much the community is engaging, one card per story.\nTrending right now. A separate view for what's spiking in the last few hours.\nTap any story for the full picture. Each topic page shows the community's best posts about it, the replies underneath, and links to the source articles.\nCommunity moments included. The weekly Blue Sky Art Show, fandom buzz, and Bluesky-native happenings sit alongside the news instead of getting buried.\nDaily archives. Look back at any day's top stories. We also post a Morning Sky summary to @topics.blue every morning.\nFilter by what you like. Art, gaming, music, photography, politics, sports, tech, TV, science, and more.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:zfgf67pufgup55go5r3viyor/bafkreihd54betv5bdkg4td23fis7vciz6vb6lfgqoazfjyywewbvwuwwbu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:zfgf67pufgup55go5r3viyor/bafkreifjnp7wesdtjypkiwkkmiyxm2anbknegoa3pni2xqjjukrr6srkla@png",categorySlugs:$R[156]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"topics.blue",appTags:$R[157]=[]},$R[158]={id:"482a068b-ec21-497e-8c56-5c5816b0e04f",name:"Mackinac",slug:"mackinac",tagline:"Your bridge to the Social Web.",description:"Mackinac is a multi-protocol social client that connects Bluesky, Mastodon, and the broader Fediverse — follow and interact across the social web from a single app.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:4mbbqw5stoosemcqf66wmrcd/bafkreiaxmtqvyq7yk2uztroashdlpnt2loe3pzaq4r6tv7bnebsznir634@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:4mbbqw5stoosemcqf66wmrcd/bafkreihfnlggopvo26uqhynrsz3baaj3rs2bimil7r2dtmlvd4s74k2mhq@png",categorySlugs:$R[159]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"mackinac.social",appTags:$R[160]=[]},$R[161]={id:"a237f132-491a-4dbb-8591-558f8275c504",name:"Glidespan",slug:"glidespan",tagline:"Bluesky for macOS Power Users",description:"A native macOS client for power users who treat Bluesky as a serious tool, or simply love their feeds. Multi-column dashboard, scheduled posts, keyboard controls, analytics, and a true macOS feel.\nStandard is free and includes unlimited columns; Pro ($8.99/mo) unlocks analytics, multi-accounts (up to 5), post-scheduling.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:vjffelvtnt72tdx4ivqoh7qx/bafkreiay545f4xtzh6xoqwbnvbnkrm2f2dtihhvd3ftxl2tzqw2bhygzl4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:vjffelvtnt72tdx4ivqoh7qx/bafkreid3tm76gpelo4xcjxj6fibd7ymxta5eeib5a6zrhitbuf3cbkw2y4@png",categorySlugs:$R[162]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"glidespan.app",appTags:$R[163]=[]},$R[164]={id:"0e8260f5-7c74-4db1-a123-2704d13a0c3b",name:"Lazurite",slug:"lazurite",tagline:"The ATmosphere client that rocks",description:"Lazurite is a modern Bluesky & BlackSky client built for people who want speed, clarity, and control.\n\nBrowse your timeline, join threads, discover people and posts, and publish with confidence using local drafts and scheduled posts. Lazurite combines a clean reading experience with advanced tools that power users and developers have been asking for.\n\nWhat you can do in Lazurite:\n\n- Read your home feed with unique themes and configurable layout options\n- Write posts with rich text, media attachments, replies, and quotes\n- Save drafts locally, so your work survives crashes, force-closes, or bad connections\n- Schedule posts to publish later\n- Search by meaning with on-device semantic search (saved and liked posts)\n- Audit your follows to identify deleted, deactivated, suspended, or blocked accounts, and even batch-unfollow from one screen\n- View account backlinks and moderation context through Constellation integration\n- Explore AT Protocol repositories, collections, and records with built-in developer tools",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:xg2vq45muivyy3xwatcehspu/bafkreibzfh7f6zckuid4shkx7pypszkv2naktjw5blnowrc3jn63yp4dw4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:xg2vq45muivyy3xwatcehspu/bafkreiaj6uowp7gfsj5nozxahwhiy4b2n7ropfetnqo37qfgpugqpg25oi@png",categorySlugs:$R[165]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"desertthunder.dev",appTags:$R[166]=[]},$R[167]={id:"ab01630e-cfa0-4b1d-ae2a-cc3ea1e5b65f",name:"Deletem",slug:"deletem",tagline:"Clean up your digital footprint on Bluesky",description:"Bulk delete posts and likes on Bluesky or on any self-hosted ATProto server you use. Set filters, preview what matches, then remove what you want",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:pk3czux3rpsw47moiofdwnvi/bafkreig2eipydep23rewltsojlni6xea36ytxrz2qvj76lxfduuu2magay@jpeg",heroImageUrl:null,categorySlugs:$R[168]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"deletem.app",appTags:$R[169]=[]},$R[170]={id:"74678017-3ff8-461b-912d-6ff8c0d37ca2",name:"Pinkleap",slug:"pinksky",tagline:"A photo-first client for Bluesky, Mastodon & Pixelfed.",description:"Pinkleap is the photo flavor of the ATProto network.\n\nFeatures include:\nStories: Post updates that are visible for 24 hours, keeping your content fresh and in the moment.\nPosts: Share your photos and videos anytime. Whether it’s a snapshot or a video, it’s easy to upload and share.\nEngage: Comment on posts and interact with others. Start conversations or leave feedback — it’s all about sharing your thoughts.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:bokpqlfmibo7e6borxfbfice/bafkreibgh3xlub4ybkulwvwtqdqcg3oowjabhh4skpuk2z4jo46ckbcpxi@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:bokpqlfmibo7e6borxfbfice/bafkreidgorjvos6eru46eopbg4rpkhuh6dlingjbfqapidfggdnbgztoau@png",categorySlugs:$R[171]=["apps/bluesky"],categorySlug:"apps/bluesky",category:"Bluesky",accent:"blue",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"pinkleap.app",appTags:$R[172]=["photo","video"]},$R[173]={id:"6434d4cc-d0df-471f-9a9a-5b5997f45ca4",name:"Himmel",slug:"himmel",tagline:"Offline feeds for Bluesky",description:"An offline-capable feed reader for Bluesky with simplicity in mind. Himmel is a place to read your Bluesky feeds even when you don't have an internet connection. Connect Himmel to your Bluesky account and enjoy your pinned feeds just as you've set them up on Bluesky. For iOS and Android.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:thf3wjswtdybdl64i3fh6bav/bafkreidq26hdobd2x5mrsboop3wjpdjltzhjh37cmm732wxes5fvrlgmba@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:thf3wjswtdybdl64i3fh6bav/bafkreidslcclmyhpkzcet3lyst5lihx3or2ns4hi6wi52q6isachqhjbfa@png",categorySlugs:$R[174]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"himmel.app",appTags:$R[175]=[]},$R[176]={id:"be92c4f8-cc3a-4a04-b7a8-b4a0de4e92bd",name:"Vanity Blue",slug:"vanity-blue",tagline:"Get a custom Bluesky Handle",description:"Choose from unique handle styles that match who you are. Quick setup, instant activation.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiahg654jq5vws6mj4qav43aae7nnigm7oa47kjnc5orfb5jszp6gy@jpeg",heroImageUrl:null,categorySlugs:$R[177]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"vanity.blue",appTags:$R[178]=[]},$R[179]={id:"335544e1-0acd-485d-9c14-cbe5339a19fa",name:"Unthread",slug:"unthread",tagline:"Draft and publish Bluesky threads in one place.",description:"Unthread is a focused Bluesky client for writing thread-style posts, saving drafts, and publishing finished unthreads from a dedicated drafts-and-posts workflow.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreif6um65gopd7jval5r7te64af4v7zuyuh2fkjjg6unmulnnumqaoq@png",heroImageUrl:null,categorySlugs:$R[180]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"unthread.at",appTags:$R[181]=[]},$R[182]={id:"c461a5b2-b5bb-4314-8a58-d9ec80f03351",name:"TrendSpotter",slug:"trendspotter",tagline:"Discover trends and viral content on Bluesky Social.",description:"TrendSpotter helps you find viral and trending content on Bluesky Social. The tool allows you to search and discover popular posts that are gaining traction across the platform, making it easier to stay current with what's happening in your network.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigjjtsxtvof4jlrwmecmlpajoxfukjd6s2mkz54jekrrvnkcc2why@png",heroImageUrl:null,categorySlugs:$R[183]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"trendspotter.bsky.social",appTags:$R[184]=[]},$R[185]={id:"0bb1fc85-1628-4574-91ec-0fea9a5949ce",name:"Trending Hashtags by Skyscraper",slug:"trending-hashtags-by-skyscraper",tagline:"See what hashtags are trending on Bluesky",description:"A very quick, simple, and fast loading page to track the leading hashtags on Bluesky over the past hour, day, week, or month. Goal is to be fast and easy to access. See what hashtags are trending today!",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibygfrbe2tr2gcph4modyw3lm63xo4kidsr4kqujw2uycbxcggmn4@png",heroImageUrl:null,categorySlugs:$R[186]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"trending.bsky.social",appTags:$R[187]=[]},$R[188]={id:"23b11f3a-73a5-4c57-842b-2eb78ac54c64",name:"The Bluesky Dictionary",slug:"the-bluesky-dictionary",tagline:"Can Bluesky say every word in the English language? Well this is your chance to find out.",description:"Can Bluesky say every word in the English language? Well this is your chance to find out.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaecx557emowg37hnqb7w6lm2o6yi7p7lirez72m3wpmzlxvoy3la@png",heroImageUrl:null,categorySlugs:$R[189]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[190]=[]},$R[191]={id:"09906b80-7fe3-4b36-af39-88e58c4b96e4",name:"SuperX Bluesky Analytics",slug:"superx-bluesky-analytics",tagline:"Insights for your Bluesky activities and engagements",description:"Bluesky analytics tool that helps you learn about your activitiesFeatures:- View tweet replies- View profile's best tweets- Share beautiful charts and create poster, with 16 different styles- Search with instant results and shortcuts- Overview graphs: Activity Frequency, Activity Impressions, Activities for Tweets/Replies/Retweets, Engagement for Likes/Retweets/Replies/Bookmark- Tweets/Replies table: See all of your tweets and reply to other tweets in table format- Click an item on the Frequency graph to see activities- Added Reply to your posts tab- Display as sidebar- Dark/dim/light mode- View other profiles",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreif3gozkdfik4lw4othjzityrgwrfdfi2cssnjjlumqh7j6ph5ture@png",heroImageUrl:null,categorySlugs:$R[192]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[193]=[]},$R[194]={id:"baa599c2-5086-4885-8731-76b79b62e700",name:"SoraSNS",slug:"sorasns",tagline:"iOS client with local For You timeline and beautiful UI, supports Bluesky, Mastodon, Misskey, Nostr all in one",description:"\"Sora offers access to Mastodon, Bluesky, and the federated networks Misskey and Firefish.\" - featured in TechCrunch article◐ Super engaging timeline ◑ local algorithm powered For You timeline, mixing home, trending, and other posts to help you discover more from the Fediverse◐ All in one ◑ Connect with Mastodon, Misskey, Bluesky, Pleroma, and Nostr instances.◑ Repost, like, view notifications, and follow profiles using any of your logged in accounts, with just one-tap◐ Gallery mode for viewing arts and photos, and Watch tab to explore videos by scrolling◐ Automatically fetches the complete post likes, replies, and profiles information from remote servers.◐ Send threaded posts, add images, videos, GIF easily.◐ local LLM powered replies summary◐ Supports Misskey Pleroma post emoji reactions viewing and sendingSora is the fediverse client for the future!■ \"For You\" TimelineOn-device algorithms learn about your interests, surfaces posts from across the Fediverse, and intelligently mix them into your home timeline.■ Share extensionUse the systemwide sharing feature to easily share your pictures and links to fediverse■ Safari extensionWhen you are browsing fediverse websites in Safari, you can quickly open the same post or profile (on the web page) in the Sora app. The app also tries to find the post or profile on your own instance server so you can perform interactions like like and follow.■ Sorted NotificationsNotifications are automatically grouped on post basis.System notifications come with profile pictures.Direct mentions are streamlined into the DM notification tab for easy access to full conversations.■ Gallery View & Video ViewImmerse yourself in the profiles of artists and photographers with a dedicated gallery browser.Use the video tab to scroll through interesting videos throughout the Fediverse.■ Bookmark FoldersKeep your favorite content organized with specialized bookmark folders.Add posts to bookmarks even if you are using Bluesky.■ MissKey FeaturesView, follow, and post to Misskey channelsReact with emojis to MissKey posts and view others' reactions.Quick-access emoji reactions with a long press on the like button.Browse the drive and see your files and foldersSupport your server since Sora shows the advertisements set by your instance adminAccess your saved files and folders when logged into Misskey or Firefish.■ Search CapabilitiesComprehensive searches across posts, accounts, and hashtags.Stay in the loop with trending hashtags.Paste fediverse URL and fetch the post on your local instance.■ Post EditorEnrich your posts with text, images, videos, maps, and URLs.Pick a GIF animated image from TenorCompose multiple posts and post them within one thread■ Optimized Post RenderingQuoted posts and profiles automatically rendered■ Multi-account supportFluidly switch between Mastodon and MissKey accounts.Repost and like a post using any of your logged in accountsFollow a profile with any of your logged in accounts■ Platform CompatibilityWorks seamlessly with Mastodon, Misskey, Firefish, Bluesky, and Nostr■ QR Code SharingShare profiles and posts effortlessly via links or QR codes. Integrated QR scanner available.As listed on Mastodon official website: https://joinmastodon.org/appsAs listed on Bluesky official website: https://docs.bsky.app/showcase?name=Sora",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifoq3u4ajbggxsh4r7trc3rz5ilaiqpddvz6prcvn53ta5w45tnvi@png",heroImageUrl:null,categorySlugs:$R[195]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[196]=[]},$R[197]={id:"be6dba70-7ecb-45e4-a77d-bac064f7d1ad",name:"Skyswipe",slug:"skyswipe",tagline:"Your Bluesky videos, one swipe at a time.",description:"Explore BlueSky videos with custom feeds, threaded replies, smart filters, and easy sharing — Skyswipe makes your experience smooth and fun.SkySwipe is the fast, swipe-first way to watch short-form video from the open Bluesky network. Pick the feeds you trust, skip what you don’t, and enjoy an endless stream of bite-sized clips that feel curated just for you—all with zero tracking and a privacy-first design.■ Choose Your AlgorithmAdd any Bluesky feed or list. Your timeline adapts to what you follow, not what ads demand.■ Swipe Through Endless Short ClipsOne-thumb scroll for quick laughs, sports highlights, tutorials, and more—no waiting, no clutter.■ Threaded Replies Made SimpleDive into full conversations beneath any video, collapse threads, like, repost, or reply in seconds.■ Smart Content FilteringSensitive-content warnings appear up front, while muted or blocked accounts stay hidden automatically.■ Effortless Sharing & ListsSystem Share Sheet in light and dark mode. Add creators to your lists straight from the share menu.■ List Management in SettingsCreate, edit, or reorder every list you curate—add or remove people with a tap.■ Invite Friends InstantlySend built-in invite links so friends can start swiping right away.■ Privacy First—Zero TrackingNo analytics, no hidden data collection.■ Faster Every UpdateEach release brings smoother playback, reduced load times, and UI polish.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihn6wyjpl4kt62a243hrxxfvmfpmymemgbacnv7lf6nnvyemccsfe@png",heroImageUrl:null,categorySlugs:$R[198]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[199]=[]},$R[200]={id:"75f35e36-4434-4945-be4f-3a13ebfb59c6",name:"SkyPilot",slug:"skypilot",tagline:"Publish smarter, grow faster on Bluesky with all-in-one analytics and post scheduling",description:"SkyPilot is your all-in-one publishing and analytics toolkit for Bluesky. Designed for creators, marketers, individuals, agencies and brands, it makes building an audience easier and more effective with tools like:✈️ Smart publishing – schedule posts in advance and hit optimal posting times automatically🔍 Hashtag & keyword insights – research what’s trending and what resonates with your audience📊 Actionable analytics – track growth, engagement, and performance without the clutter⚡ Audience view upgrades – faster, clearer insights to help you connect with the right people🛠️ Productivity boosters – automation and streamlined workflows to save you timeWhether you’re promoting a brand, growing a community, or just want to post more effectively, SkyPilot helps you fly higher on Bluesky.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieeg3ihl23i2bypwofjh2s3bt33q2hsl24ucbzvpgb3jewo5j73yq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiblotpxq3he3flhh6siznjtk7pohngspxu7icevsugkdchmvqvedm@jpeg",categorySlugs:$R[201]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skypilot.social",appTags:$R[202]=[]},$R[203]={id:"a528f23b-5a1d-47b1-8392-49764e9f270a",name:"SkyMarks",slug:"skymarks",tagline:"Download SkyMarks by Old Jewel Software on the App Store. See screenshots, ratings and reviews, user tips, and more apps like SkyMarks.",description:"looks and functionality SkyMarks is the Bluesky bookmarks app for your iPhone, iPad and Mac. Bluesky is the biggest thing happening in social media in 2025. It seems like everyone is jumping on board, with over 31 million users as of February. When you jump in, though, you may find some things that you miss from your old social networks, like the ability to bookmark a post. It’s a common thing to want to save a post to come back to later. Maybe you want to think a while before responding. Maybe the post has a useful link in it that you want to come back to. Or maybe you just really like the post and want to keep it around. Until Bluesky decides to implement bookmarking itself, SkyMarks can be your Bluesky bookmark manager. To bookmark a post from your browser, just tap the share button (the button with the arrow pointing out of a box) and then select SkyMarks from the list of available options. Once you’ve bookmarked a post, it will be available in SkyMarks whenever you need it. SkyMarks synchs its bookmarks across all your devices that use the same Apple ID. So if you bookmark a post while you’re waiting in line at the grocery store, you’ll find it on your iPad when you’re reading in your living room or your Mac when you’re working at your desk. SkyMarks has robust features to find bookmarked posts. You can search by post text, author name, author handle or even your own notes. You can even search the text in images attached to posts you’ve bookmarked! You can also tag bookmarks and view bookmarks by tag, so you can use SkyMarks for multiple projects and still get to the bookmarks you need when you need them. SkyMarks is free to use and has no in-app purchases. It’s just here to make the transition to Bluesky a little easier for you. If you find a bug or want a feature, please provide feedback. SkyMarks will hopefully one day be open-source. There are a few issues that need to be figured out before its code is released to the public though. more",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicwsjueb7kacq3nedavzhqcltyzs4ixs3kl642o47posv5ygvz76e@jpeg",heroImageUrl:null,categorySlugs:$R[204]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[205]=[]},$R[206]={id:"23ec07f3-37c7-4939-99fd-1e16f861c4aa",name:"Skykit",slug:"skykit",tagline:"SkyKit is a tool to get stats about Bluesky users.",description:"SkyKit is a tool that provides statistics and analytics for Bluesky users. It allows you to view detailed metrics about your Bluesky account activity and engagement.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidbuoqqqjtfmkmsxnc5w2aojjzxztc7da3buonsby6tw7n4pbkiai@png",heroImageUrl:null,categorySlugs:$R[207]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skykit.blue",appTags:$R[208]=[]},$R[209]={id:"f6111377-4362-41bb-b688-61d2a1898dc0",name:"Skydeck.live",slug:"skydeck-live",tagline:"A world-class web frontend to the Bluesky social media platform.",description:"A feature-complete Bluesky social media web frontend with a multi-column \"deck\" interface, inspired by deck.blue.FeaturesMulti-Column Layout: Drag-and-drop customizable columns for Home, Notifications, Messages, Search, Lists, Custom Feeds, and ProfilesFull Bluesky Integration: Complete ATProto API support for posts, feeds, DMs, notifications, and moderationTheme Customization: Full control over colors, typography, layout, and custom CSSReal-time Updates: WebSocket-powered live feeds and notificationsMedia Support: Images, videos, GIFs, and link previewsModeration Tools: Block, mute, report, and word filteringResponsive Design: Works on desktop and mobileAccessible: WCAG 2.2 compliant with keyboard navigation",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibtxuzxhqga3c6d4ozverssgkhluiad7k23irie5uqjkyctwc2n5i@png",heroImageUrl:null,categorySlugs:$R[210]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[211]=[]},$R[212]={id:"672a7332-af1e-4ffa-bc32-ea8688d4092d",name:"SkyCord",slug:"skycord",tagline:"Seamlessly link your BlueSky posts with your Discord Community.",description:"SkyCord Is A Discord Bot That Forwards Your Bluesky Posts To Discord In A Nice Embed That Support Up To 4 Images With Alot Of Customization Options. SkyCord supports posts, replies, reposts and quote reposts",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid376oj26ykxcpfpib7rt2moeeyi4b6mwuezrfjtv426jj6cggyzi@jpeg",heroImageUrl:null,categorySlugs:$R[213]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skycord.app",appTags:$R[214]=[]},$R[215]={id:"40b9d6eb-16d1-4d46-9dab-9f107942a8b0",name:"Sky.app",slug:"sky-app",tagline:"A great way to use Bluesky Social on MacOS",description:"Sky.app is a great way to use Bluesky Social on MacOS. It features keyboard shortcuts, Dark Mode Sync, and notification badges.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaoefqczqijjbvhxtvxowxnbmpoqb77n4q553ritqviklzg2nrnoa@png",heroImageUrl:null,categorySlugs:$R[216]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[217]=[]},$R[218]={id:"ee98faad-3881-4bdf-8f8a-0eed0d5180c0",name:"ShadowSky",slug:"shadowsky",tagline:"Free Bluesky Analytics & Notifications",description:"Transform your Bluesky notifications into insights. Track conversations, analyze engagement, never miss what matters.Smart Notifications FeedAll notifications organized with filters, aggregation, and unread tracking. See likes, reposts, follows, mentions, and replies in one place.Conversation TrackingNever lose track of replies. See all conversations in threaded view with search and unread indicators.Engagement AnalyticsSee trends, top engagers, and activity patterns. Understand when and how people interact with your content.Lightning Fast & Works OfflineLoads instantly with intelligent caching. Pre-fetches 4 weeks of data for offline access.Visual TimelineBeautiful chronological view of your notifications with activity bursts and time gaps.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreie5wk2uoqyrnnxfuk65npqa3l6zgk3ujekqtswu4nib6ikdfwbo6e@png",heroImageUrl:null,categorySlugs:$R[219]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[220]=[]},$R[221]={id:"6c90e5a3-e741-4ccd-b6c9-e991047e9315",name:"Red Dwarf",slug:"red-dwarf",tagline:"Independent Bluesky client that does not depend on AppView servers.",description:"Red Dwarf is an independent Bluesky web client that fetches records directly from each user's PDS and reconstructs relationships through backlinks, with optional AppView usage as an optimization layer.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiabtv2bhiyoncjgau734e3prfss5s5v46sspcolccq2pupwcu4wny@png",heroImageUrl:null,categorySlugs:$R[222]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"reddwarf.app",appTags:$R[223]=[]},$R[224]={id:"4e981e6c-fa75-40a9-a14e-65d31259b09d",name:"PostWatch",slug:"postwatch",tagline:"Instant notifications for keyword mentions on Bluesky",description:"Get notified instantly when keywords are mentioned on socials. Engage to turn mentions into customers.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibg3ozd35tpvxtl7bsnemvxsyoql22x5ixmknvk6yccunzyfo2c6y@png",heroImageUrl:null,categorySlugs:$R[225]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[226]=[]},$R[227]={id:"17fdc4b8-b850-4517-ac15-45e5cf3d6646",name:"OneUp",slug:"oneup",tagline:"Schedule your social media posts",description:"The simplest way to schedule & manage your social media posts.Bluesky announcement post: https://blog.oneupapp.io/bluesky-scheduler/",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiek4zn2zrpr42j2ol4pudpxmojuz6rkfe2cwoa37vepfwzqzvs5ra@png",heroImageUrl:null,categorySlugs:$R[228]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[229]=[]},$R[230]={id:"7df3288d-4f41-4d63-8263-d0f0f4ec1029",name:"NowPlaying.blue",slug:"nowplaying-blue",tagline:"Discover new music with NowPlaying.blue",description:"NowPlaying.blue is a simple way to see what music people are sharing on Bluesky. It pulls in posts with the #nowplaying hashtag and updates in real time, making it easy to discover new tracks.Just press play to start listening on Spotify.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigoyvaqerwpxhm3rg3oeanfrh2avg3vc5a2vmtwdzoqsfzixbd43u@png",heroImageUrl:null,categorySlugs:$R[231]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bskyline.app",appTags:$R[232]=[]},$R[233]={id:"3b720314-1ad4-43ab-848a-a869dacd6a4c",name:"Monadsky",slug:"monadsky",tagline:"Scheduling Solution Built For Bluesky Professionals",description:"Effortlessly create and manage content with our intuitive WYSIWYG editor, schedule posts with precision, and stay organized with an interactive calendar.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid5gqkfgpxnki5iowh2vktrdnr2s7ufejdwfw62vsqsd7isnnbhoy@png",heroImageUrl:null,categorySlugs:$R[234]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"monadsky.com",appTags:$R[235]=[]},$R[236]={id:"03a3e579-3787-4cbc-a179-af372e75cd92",name:"Localsky",slug:"localsky",tagline:"Sell and Find local deals, services, and businesses on Bluesky",description:"LocalSky turns Bluesky into your city’s marketplace. Discover local items for sale, services, and small businesses near you—then browse everything in a scrollable, TikTok-style feed so you can quickly see what’s happening around where you live.Anyone can create a listing for what they’re offering locally—whether it’s a yard sale, a used item, a side gig, home-cooked food, a small business announcement, or a community update. It’s also a simple way to spread the word about fundraisers, events, meetups, and local happenings that actually benefit people in your area.Whether you’re looking for a deal, a handyman, a last-minute dessert tray, or something fun to do this weekend, LocalSky makes it easy to find nearby posts without digging through global noise. Add multiple cities, switch between them anytime, and search fast so you can track what’s available where you actually are (or where you’re headed next).Built on the AT Protocol, LocalSky keeps the experience social while making it practical: real people, real listings, and real local discovery—not shouting into the void. The goal is simple: help neighbors support neighbors, and help local businesses and community causes get seen.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicrvjt6z7m7kswqfmu6pzbncj3nnceqsoduzq55bg4rxqao6mxnnm@png",heroImageUrl:null,categorySlugs:$R[237]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[238]=[]},$R[239]={id:"6057ca4a-761a-460d-a14b-51b815377f55",name:"Kyst",slug:"kyst",tagline:"Your Bluesky Bookmarks Manager",description:"Kyst offers a combination of browser extensions and a webapp to enhance your Bluesky experience by providing advanced bookmark management capabilities. It not only lets you bookmark your favorite posts, but also organize and sync them across devices. The extension is designed to make the bookmarking experience seamless and efficient. It adds a bookmarking button to each post, allowing you to save them easily (or to remove them, if marked previously). Then, there's the sidebar, where you can see and manage your bookmarks. The extension automatically syncs your bookmarks with Kyst servers, ensuring they're always up-to-date, across browsers and devices.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreickun4jktwc56moagxipmdbdz56omqghxb4irfgyrvuosxwmwgany@png",heroImageUrl:null,categorySlugs:$R[240]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"kyst.app",appTags:$R[241]=[]},$R[242]={id:"cdb944f4-4e3c-4d1d-b6ae-e02dc15d5c60",name:"Gridsky",slug:"gridsky",tagline:"Instagram on Bluesky. Supercharged",description:"This client brings the Instagram experience to the Bluesky network but with superpowers like customizable grids, animated cubes, themes and more",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibsmf753zuuca265jrcfyym4eqg6lw7kw3qnny2pyalffjt3enhzi@png",heroImageUrl:null,categorySlugs:$R[243]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[244]=[]},$R[245]={id:"6e0a908d-22ad-466c-8f15-b114a7a7eb28",name:"Graphtracks",slug:"graphtracks",tagline:"Graphtracks offers a comprehensive database of statistics and analytics for the fediverse and decentralized social media platforms.",description:"Top 100 Bluesky Accounts. Want to know who's making waves? Check out our list of the most engaging accounts over different timeframes.\n\nSearch & Analytics for Any Account. Curious about how an account is doing? Look up any public BlueSky profile and get a quick snapshot of its performance—engagement trends, top posts, and more.\n\nIf your day starts and ends with BlueSky, Graphtracks will be your best friend! Join now and discover powerful analytics that will help you make informed decisions. With our platform, you can better understand your online presence, spot important trends, and improve your content strategy.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiajumn2sgliom5q3obaf5noflwezs327izi6rikkrxehdfbsnntze@jpeg",heroImageUrl:null,categorySlugs:$R[246]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"graphtracks.com",appTags:$R[247]=[]},$R[248]={id:"c54c9bbf-c56a-4c1b-8a9b-87d26c7a89e4",name:"GoBlue",slug:"goblue",tagline:"Bluesky profile analytics for iOS",description:"Get advanced analytics for your Bluesky accountGoBlue allows you to access advanced analytics of your Bluesky account.Easily connect your Bluesky accounts to the app.Choose from an expanding collection of statistics to expertly track your Bluesky account.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihuov7qqlqbtngkisan7r4hj6zgxgbkix2dfsm3exwdqjta4xmbwa@jpeg",heroImageUrl:null,categorySlugs:$R[249]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[250]=[]},$R[251]={id:"87815353-1037-49bd-9dcf-3e436169b366",name:"Dragonfly",slug:"dragonfly",tagline:"Bluesky's very first desktop and iPad experience.",description:"Experience Bluesky like never before. Dragonfly makes it more intuitive, smoother, and effortless on desktop and iPad.Key Features 💙Native Desktop Experience – Optimized for macOS, soon available on Windows and Linux.Seamless Navigation – Smooth scrolling, keyboard shortcuts, and intuitive UI.Search & Browse – Find posts and users with ease, and explore your timeline, followings, discover, and pinned feeds.Multi-Account Support – Easily switch between accounts without logging out.Persistent Sessions – Pick up right where you left off when reopening the app.Follow, Unfollow, Block & Unblock Users – Manage who can interact with you.Pinned Posts – Pin posts and view pinned posts on profiles.Dark & Light Mode – Choose the theme that suits you best.Privacy-Focused – No data collection; your experience stays yours.Translate – Translate posts using Google Translate, just like on Bluesky.Better Notification Management – We’ve grouped notifications by type (e.g., follows, likes, mentions, starter packs...) for simpler navigation.Improved Video Handling – We’ve fixed video quality issues, ensuring sharp, crisp playback with no pixelation.Report Bugs – Found a bug? Report it directly from the app.Coming Soon ✨Notifications Improvements – Get push notifications for mentions, follows, and more.Drafts – Save posts as drafts and edit them later.Bookmarks – Keep track of posts you want to revisit.Alt Text Support – Add and view alt text for images.Windows & Linux Support – Expanding beyond macOS.… Got feedback or ideas? Suggest features and help us make Dragonfly even better.Development: Sébastien Gruhier (Async Development)Design: Inès Gruhier (Odubu Design)",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreietavtczv5vfixaf36qyir6hpldh6ncmrprpjxz4zpj46ahiv23w4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihmf4e3hvfw7n77envcxlm5knbasxnlmxc7e4r7hr7gv2puinpehm@png",categorySlugs:$R[252]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"dfly.app",appTags:$R[253]=[]},$R[254]={id:"dba6bfe5-1cf5-41c2-bef5-e0c957ce5f4d",name:"Debya",slug:"debya",tagline:"Stay Sharp on Bluesky. Debya’s Got Your Back.",description:"Debya is your toolkit for staying ahead on Bluesky. Instantly see who unfollows you, get alerts when you're added to a list, track what specific accounts are liking, and dive into engagement insights over time. Whether you're a creator, a brand, or just curious, Debya gives you real-time data and exportable reports to help you stay informed and in control. And we're just getting started — more powerful tools are on the way.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihkvz4yas4zoyiuppbdmrczgx2uanq54gxjde2zyucwwrhyvu56ke@png",heroImageUrl:null,categorySlugs:$R[255]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"debya.com",appTags:$R[256]=[]},$R[257]={id:"0ca8d27b-bf35-4298-8b47-ad46de5a4e40",name:"DarkSky for BlueSky",slug:"darksky-for-bluesky",tagline:"BlueSky client for Windows 10/11",description:"DarkSky (Preview): A third party BlueSky client for Windows 🎉 DarkSky brings BlueSky to Windows with a sleek, modern design crafted for the best user experience. Effortlessly explore your feeds, profiles, posts, replies, and media—all in one intuitive app. As a community-driven app, DarkSky is evolving quickly with frequent updates and new features added regularly. There's a dedicated Discord and GitHub repo, giving you a direct line to influence the app's development and help shape its features.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaoefqczqijjbvhxtvxowxnbmpoqb77n4q553ritqviklzg2nrnoa@png",heroImageUrl:null,categorySlugs:$R[258]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[259]=[]},$R[260]={id:"3ceaa9f4-7b44-452b-9754-dfbe82a7f6d3",name:"Butterfly for Bluesky",slug:"butterfly-for-bluesky",tagline:"Download Butterfly for Bluesky by Reuben Catchpole on the App Store.",description:"Butterfly – Bluesky for Apple Watch Browse Bluesky, post updates, check notifications and message – all from your wrist. Experience the most polished Bluesky client built exclusively for Apple Watch. As featured in: The Verge – “Butterfly brings Bluesky to your Apple Watch” 9to5Mac – “Butterfly puts Bluesky on your Apple Watch with a beautiful app” Lifehacker – “The highlight is the app’s beautiful design” more\n\nBluesky on Apple Watch! 12/18/2024 Korrrrrrl I’ve been hoping someone would make a Bluesky client for Apple Watch and this is it! This app works great on my Ultra 2 and looks great too. I do hope that the dev can add an option to confirm a repost as it’s often easy to accidentally hit the repost button when trying to hit the like button. Bluesky on Apple Watch! 12/18/2024 Korrrrrrl I’ve been hoping someone would make a Bluesky client for Apple Watch and this is it! This app works great on my Ultra 2 and looks great too. I do hope that the dev can add an option to confirm a repost as it’s often easy to accidentally hit the repost button when trying to hit the like button.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifdwo4bycdo6mra5h5busox7jikofllsjohhklcycs7kyzwtq63pi@jpeg",heroImageUrl:null,categorySlugs:$R[261]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[262]=[]},$R[263]={id:"081a9ea7-aaad-4387-9fb6-df0b677375b8",name:"BskyCharts",slug:"bskycharts",tagline:"Public Bluesky charts for activity, growth, and network health.",description:"BskyCharts is a public monitoring dashboard for Bluesky activity and related network signals, published as a set of continuously refreshed charts. It tracks metrics such as overall activity, embed usage, labels added, operation rates, post languages, user growth, bsky.network PDS status, and PLC activity across day, week, month, and year views.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidql7lhhkimmxgfein2dtprr5ipnrow637q6ab3354cboo7uyfv5y@png",heroImageUrl:null,categorySlugs:$R[264]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bskycharts.edavis.dev",appTags:$R[265]=[]},$R[266]={id:"41e6cb9c-d1a3-4b5d-95fb-5f14412a2f3d",name:"Blueview",slug:"blueview",tagline:"Get powerful insights and analytics for your Bluesky social presence.",description:"Track engagement, analyze growth, and understand your audience better.Built by @srsholmes.com",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibpvcxfd6zwpxg6hd4ou5r73d5csyfjpcnr2hmevfxcmhz6h7z25y@png",heroImageUrl:null,categorySlugs:$R[267]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[268]=[]},$R[269]={id:"d05af201-6533-4000-b529-d82a66c06134",name:"Blue Video Saver",slug:"blue-video-saver",tagline:"Download Bluesky videos instantly — free, fast, no watermark.",description:"Blue Video Saver is a lightweight, fast, and secure online tool for downloading any Bluesky video in seconds. No app install, no login, no watermark. Just paste a link and get a high-quality MP4 instantly.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigtqrrfjajx6mdw4u4oncostaththzjgy25xsug2ftp3satzqt4vm@png",heroImageUrl:null,categorySlugs:$R[270]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[271]=[]},$R[272]={id:"0ca546e2-d0b3-46bd-9872-34ea0476dda9",name:"Bluesky Widget",slug:"bluesky-widget",tagline:"Bluesky Widget: Cute Bluesky Profile Cards for your websites!!",description:"• creating @abelljs.org• design systems at blade.razorpay.com• makes silly libraries 📍bangalore 🇮🇳🌐 srbh.dev",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihjgwojgmwpt2az75j7kldd4oeccmektvtadok5gscqle5wfmtf34@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreib547jl4wgxjpxolcft4ieysk7bvxok7ddhimpnanlsx7iw4hdo2i@png",categorySlugs:$R[273]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[274]=[]},$R[275]={id:"23663dda-57ca-4f16-aa99-9ac52c63f818",name:"Bluesky Verification Explorer",slug:"bluesky-verification-explorer",tagline:"Discover and explore verified profiles on Bluesky from trusted verifiers. Stay updated with the latest verifications and trusted accounts.",description:"Discover and explore verified profiles from trusted verifiers on Bluesky. Stay updated with the latest verifications.\n\nAll verified users on the Bluesky Network. Not affiliated with Bluesky. Visit our website for more information https://bverified.vercel.app\n\nBluesky has introduced a new verification system with blue checkmarks for authentic and notable accounts. These accounts are verified either directly by Bluesky or through trusted verifier organisations.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigmlwwe7qctk6c4vamxicl2g6d5b3mw76k23frc3m3flfb7y4qcwy@jpeg",heroImageUrl:null,categorySlugs:$R[276]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[277]=[]},$R[278]={id:"b5105be5-9045-4b8f-9233-ae42dd730d28",name:"Bluesky SMS Service",slug:"bluesky-sms-service",tagline:"Send an SMS to post to Bluesky",description:"Send an SMS to +1 414-432-4321 with the message: register \x3Cyour bsky.social handle> \x3Cyour bsky.social app password>. Then, you can send an SMS to that same number at any time in order to post on Bluesky!For example, you might send register dril.bsky.social asdf-jklq-wert-yuio to 414-432-4321, and then any subsequent messages sent to this number will be posted to your Bluesky account. To register an app password, you can do so here. Login passwords are not supported. Also, please note that you will not receive any messages back from this number, due to increasingly strict anti-spam laws.After you've registered, you can text that number any time you want to post to Bluesky! Photos are supported as well! Messages longer than 300 characters will be automatically threaded, but just a heads up that due to the way longer text messages are handled, it may not appear on your feed for 2-3 minutes. Normal length posts are posted almost instantly.Let me know if you run into issues, you can raise an issue here or contact me via Bluesky here",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaoefqczqijjbvhxtvxowxnbmpoqb77n4q553ritqviklzg2nrnoa@png",heroImageUrl:null,categorySlugs:$R[279]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[280]=[]},$R[281]={id:"114010ba-b69b-4cf0-89b5-77edba3d8dc4",name:"BlueSkyScore",slug:"blueskyscore",tagline:"What is your BlueSkyScore?",description:"Generate shareable milestone images that showcase your Bluesky activity and trustworthiness with a simple numerical score.The BlueSky Score is not an official metric from BlueSky and is independently calculated by this site. It serves as a fun way to gauge activity and engagement but does not reflect any official verification or endorsement. Regardless of the score shown here, we encourage you to check out the account for yourself—there might still be great content and a user worth following! Always use your own judgment when deciding whom to engage with.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiemxli6rbhtgkzza3dmgf2k4zyjkmrgzuviwzn77r6gocvkgvttna@png",heroImageUrl:null,categorySlugs:$R[282]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"blueskyscore.com",appTags:$R[283]=[]},$R[284]={id:"7a8440d4-174d-4a8c-805f-a2d8ab2089b6",name:"Bluesky Post Formatter",slug:"bluesky-post-formatter",tagline:"Frequently Asked Questions (FAQ)",description:"Bluesky Post Formatter is a web-based tool that lets you add text formatting to your Bluesky posts. You can style your text with bold, italic, underline, strikethrough, script, and monospace formatting. The tool is free to use and works directly in your browser without requiring any software installation.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiczgx3zq2roodcqnmmcf5plavvpwdzcnicf3mk5uwvyernpos2j6u@png",heroImageUrl:null,categorySlugs:$R[285]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[286]=[]},$R[287]={id:"14aaa414-b9d3-45b6-a725-7397ef39512f",name:"Bluesky Post Count and Author Stats",slug:"bluesky-post-count-and-author-stats",tagline:"Aggregate stats for all posts in Jaz's Bluesky index",description:"Post Data Collection started May 1st, 2023Total User Count is directly from the Bluesky APILarge bot accounts are excluded from statistics and Top Posters",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaqad36wiivkyj465pi4to2bnziuyojkxaqncd34lkliq6ftr5flu@png",heroImageUrl:null,categorySlugs:$R[288]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[289]=[]},$R[290]={id:"45cd7e81-c9cb-4acc-a673-00ce7630d847",name:"BlueSky Popularity Index",slug:"bluesky-popularity-index",tagline:"Calculate BlueSky Popularity Index",description:"Introducing simple BlueSky Popularity Index Web App, designed to provide users with a comprehensive score that reflects their popularity on BlueSky social platform. Utilizing a straightforward yet powerful formula, the app calculates a user’s popularity score (P) on a scale from 1 to 10, based on key engagement metrics.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifjhj43kp6dxcls5atq267uxkedb7ba36odg5if7ch5zp7tei4i4e@png",heroImageUrl:null,categorySlugs:$R[291]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[292]=[]},$R[293]={id:"e85c5971-7b10-46f2-9af5-c017b5b453e4",name:"Bluesky feels...",slug:"bluesky-feels",tagline:"Hey Bluesky, how ya feeling?",description:"Unscientific sentiment analysis of the Bluesky firehose to visualise the mood on Bluesky, in realtime, direct from your browser.How it worksRank a list of well-known emojis with a sentiment score between -1 (extremely negative) and +1 (extremely positive)Connect to the Bluesky Jetstream firehose WebSocket service direct from your browser and consume all postsExtract emojis, not text (pictures speak a thousand words, right? I warned you it was unscientific) from each postAdd the sentiment value from each new emoji to an overall sentiment scoreVisualise positive and negative as two waves pushing against each other, and stream each emoji in realtime from right to left, positioned according to sentiment value",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaqxw5erw4fxu2zhywcimp3swgnmpmnlqxudsk4q5u2icoqbr4n44@jpeg",heroImageUrl:null,categorySlugs:$R[294]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[295]=[]},$R[296]={id:"a70f1bb3-c108-4b3e-9f92-b4725cd5ccc1",name:"Bluesky Feed Creator",slug:"bluesky-feed-creator",tagline:"Want to reach thousands of Bluesky users and developers? — Advertise on Bluesky Directory!",description:"Want to reach thousands of Bluesky users and developers? — Advertise on Bluesky Directory!\n\nQuickly design and customize your Bluesky feeds, no coding knowledge required.\n\nNever Miss a Mention on Bluesky\n\nList of your follows sorted by least active\n\nDownload Bluesky videos instantly — free, fast, no watermark.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifj743cajogu2xogcs64zaciship33ubyp4vngelivncqpwjz4gg4@jpeg",heroImageUrl:null,categorySlugs:$R[297]=["apps/bluesky/feed-generators"],categorySlug:"apps/bluesky/feed-generators",category:"Bluesky Feed Generators",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"blueskyfeedcreator.com",appTags:$R[298]=[]},$R[299]={id:"5c562aca-efcb-4c8e-b1e8-f2340e5d53d9",name:"Bluesky by the Second",slug:"bluesky-by-the-second",tagline:"Real-time analytics dashboard showing Bluesky social network activity by the second. Track posts, likes, follows, and user growth live.",description:"Waiting for firehose data… likes & reposts will populate this\n\nData tracking begins on your first visit to this page. Started tracking: 11:55:01 PM • Last updated: 11:55:02 PM",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifeb4hdrxwvqbxqjflyfoyk72gbq4ohemmp3jzf6zi7i5gsjm2rji@png",heroImageUrl:null,categorySlugs:$R[300]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[301]=[]},$R[302]={id:"6566f0c7-1e6f-47b4-af75-e87a3d53216e",name:"Bluesky Boost",slug:"bluesky-boost",tagline:"Enhance your Bluesky desktop experience",description:"Bluesky Boost adds a convenient side panel that provides rich metadata about the posts and profiles you're viewing. See relationship status (mutuals/followers), user activity patterns, and your personal notes - all from the comfort of your bsky.app feed.Features:• Smart side panel with contextual information about posts and profiles• User activity insights and posting patterns• Personal note-taking for profiles• Seamless integration with the Bluesky interface• Post bookmarking and collections (coming soon)Perfect for power users who want to get more out of their Bluesky experience while maintaining a clean, uncluttered interface.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreif3gozkdfik4lw4othjzityrgwrfdfi2cssnjjlumqh7j6ph5ture@png",heroImageUrl:null,categorySlugs:$R[303]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[304]=[]},$R[305]={id:"64cc24d1-7f10-4645-9ac2-c3fa504b0e23",name:"Bluerain",slug:"bluerain",tagline:"Bluesky firehose visualized in a Matrix-style rain",description:"Bluerain is a small artistic visualization of the Bluesky firehose, rendered with a Matrix-style rain effect.Click on a post as it scrolls down the screen to read its content.Filter new posts and keywords in real time.Customize the effect with various settings.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiccja3z4uajbvbti2yn5fgjkk62whuiz7t5bgn47icwewhhtxtooa@png",heroImageUrl:null,categorySlugs:$R[306]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[307]=[]},$R[308]={id:"0a4fc70f-0153-4fa5-89ac-e58196f8d5c0",name:"Atiskel",slug:"atiskel",tagline:"Analytics & Scheduling Tool",description:"Atiskel helps you grow your Bluesky presence with powerful analytics, engagement insights, and smart scheduling. Track followers, analyze trends, and optimize your content.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifofikrx2ruojrc7puzqal3j6ltovz7oybo6fdmeye6qkrep67smi@png",heroImageUrl:null,categorySlugs:$R[309]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[310]=[]},$R[311]={id:"17a41633-596c-4dd3-b6ef-aa5310239b0c",name:"Aerune",slug:"aerune",tagline:"Lightweight Bluesky desktop client for Windows & macOS (open-source)",description:"Aerune is a lightweight, open-source desktop client for Bluesky (Windows/macOS). It’s designed for quick “between tasks” use with a clean, web-like feel and fast rendering.Key features:Post, reply, quote, repost, likeImage upload (paste / drag & drop) and image savingNotifications and DMsMultiple accountsBookmarksProfile actions: follow/unfollow, mute, block (and manage lists in Settings)NSFW blur optionJapanese/English UI (auto-detected, manual toggle in Settings)Thread viewing and back navigation optimized for desktop workflowNote:Please use a Bluesky App Password to log in.Feed (custom feeds) is not included.Downloads and release notes:https://github.com/garuneko/Aerune",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaoefqczqijjbvhxtvxowxnbmpoqb77n4q553ritqviklzg2nrnoa@png",heroImageUrl:null,categorySlugs:$R[312]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"aerune.bsky.social",appTags:$R[313]=[]},$R[314]={id:"ee96b08a-56c2-4136-836d-c80dc67a5778",name:"Followers Analyzer for Bluesky",slug:"followers-analyzer-for-bluesky",tagline:"followers,follow check,freefollow,analytics,social accounts,tracker,analysis,find",description:"This is the best app for analyze growth of your Bluesky account, tracking users, unfollowers, and more! Followers Analyzer provides simple, smart, and efficient tools to understand your Bluesky network, get growth analytics!Security is our top priority, we will not perform any automated operations without your consent. We take all necessary precautions to ensure that your privacy is respected and that your information is safe.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiccmvux6byuoh2xsebgsgv6n33i5qwa3at4lx7lb5xmt6vr74xyby@jpeg",heroImageUrl:null,categorySlugs:$R[315]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[316]=[]},$R[317]={id:"859b6f8a-f77e-4e33-a952-691d282d4b97",name:"Hoku",slug:"hoku",tagline:"Visualize the Internet like never before.",description:"Bluesky API has been integrated into Hoku. Browse Bluesky posts, Sign In, post, like, etc. will be available in future 2026 version.About Hoku:Hoku is revolutionizing how humanity experiences digital information through unprecedented 3D visualization technology. By transforming linear browsing into spatial exploration, Hoku enables users to see more data, process this data faster, and discover connections in the data that would take hours to find through traditional browsing—ultimately saving vast amounts of time. The Hoku platform represents the evolution of Internet interaction—from fragmented two-dimensional pages to unified 3D information landscapes.Hoku has transformed the web from endless scrolling and linear page-viewing into an immersive three-dimensional landscape where information comes alive in spatial form. Imagine seeing hundreds of search results, webpages, social media posts, images, and videos simultaneously, organized in beautiful 3D mind maps that reveal connections and relationships invisible in traditional 2D interfaces.Hoku is a visual Internet platform that consolidates the fragmented digital experience into unified, navigable information spaces. While conventional browsers force users to click through page after page, tab after tab, Hoku lets users visualize entire networks of information at once. Users can literally see the interconnectedness of data, exploring the web like never before through spatial navigation that feels natural and intuitive.Download on Google Play or Amazon App Store. https://play.google.com/store/apps/details?id=com.hoku.web.browserhttps://www.amazon.com/gp/product/B0GDY1JSR5More information on official website: www.hoku.space",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigqyrfm734zkyyn6ck5kayrz6ullvbkm5dvomkajuckpmrmur3qxa@jpeg",heroImageUrl:null,categorySlugs:$R[318]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[319]=[]},$R[320]={id:"b32aac16-4f00-42f1-b441-ba15dfa00549",name:"PostingCat",slug:"postingcat",tagline:"Free Social Media Management Platform, powered by AI",description:"PostingCat is a Free Social Media Management & Scheduling App powered by AI.At PostingCat you can connect channels (social accounts) from many social media platforms (Of course, BlueSky, but also TikTok, Instagram, Facebook, YouTube, LinkedIn, Pinterest and more) and have all of them in one unique plaftform.At PostingCat you have a generous free plan with post scheduling to all platforms, automations for reposting when reaching a certain threshold, analytics dashboard and MANY AI features to create the best content for your audience.PostingCat is great for freelancers, business owners, influencers, marketing agencies and social media managers who want to grow for free.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibe3nuvu37ni7pr7sfjoeqny3ztt25cwdspub4lchp66njv3vvxoi@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifm3753b6muznskj2ifxytyhrdgdps6ay4kdiffhnnque5jxw46ea@png",categorySlugs:$R[321]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[322]=[]},$R[323]={id:"a707dbf0-1b75-4f47-ab7c-593f3228213e",name:"OnlySocial",slug:"onlysocial",tagline:"All-in-one social media tool to schedule, engage, and simplify your online presence.",description:"OnlySocial is your all-in-one social media management platform built for creators, businesses, and agencies. Schedule and publish content across 15+ platforms including Instagram, Facebook, LinkedIn, YouTube, and TikTok - all from a single, powerful dashboard. Engage your audience effortlessly with a Unified Inbox that combines comments, DMs, and reviews. Track performance with real-time analytics, optimize campaigns, and stay consistent with a visual content calendar.Turn followers into customers using customizable Link in Bio pages, dynamic QR codes, and VCard tools. From bulk posting and first-comment scheduling to built-in media tools and team collaboration, OnlySocial simplifies social media so you can focus on growth.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidxktxbwelq5hty5xpnzb36va4vwbblu5asltviofev72sqbenxlu@jpeg",heroImageUrl:null,categorySlugs:$R[324]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"onlysocial.bsky.social",appTags:$R[325]=[]},$R[326]={id:"43e997b4-386c-46e2-aa2c-f6ff8cf709ac",name:"Skircle",slug:"skircle",tagline:"Create Bluesky Interaction Circles with ease!",description:"Skircle provides audience analytics for Bluesky creators and professionals. Built on the AT Protocol, our tool analyzes your engagement metrics and interaction patterns to visualize your social network. Track your most active connections and discover insights about your Bluesky presence. We securely cache public data to help you understand your growing community and social reach on decentralized social media.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigp5p3qz3b7bvjuwlbyaqvw4iw5wx6gdu2qx4fbyl2qn6zw424hua@jpeg",heroImageUrl:null,categorySlugs:$R[327]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skircle.me",appTags:$R[328]=[]},$R[329]={id:"354143c8-2d84-487a-85b9-d1c29caa92f3",name:"BluePrint",slug:"blueprint",tagline:"BluePrint: Custom Bluesky theming by Postpone",description:"Google recommends using Chrome when using extensions and themes.\n\nCustomize your Bluesky experience with new colors, navigation, and layout settings. 🎨 Theme Bluesky with 12 beautiful colors. 📏 Make your feed wider. ✨ Remove clutter and distractions. 👤 Hide unused navigation items. From the makers of Postpone, the all-in-one social media marketing tool for creators, agencies, and brands. Learn more at www.postpone.app.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihtkz4xy7h5hv3ujxmgkhpcqm65p3wjillenije4yov3lmvwz67ue@png",heroImageUrl:null,categorySlugs:$R[330]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[331]=[]},$R[332]={id:"80f7dbbe-36ac-4376-a696-442f831328ad",name:"Bluesky+ Sidebar",slug:"bluesky-sidebar",tagline:"Add bookmarks, trending topics, drafts, to Bluesky.",description:"Enhance your Bluesky experience with BlueskyPlus - an all-in-one, 100% FREE sidebar that helps you track what matters, save what you love, and make Bluesky your own.. No login required, and your data stays private, on your device.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihtkz4xy7h5hv3ujxmgkhpcqm65p3wjillenije4yov3lmvwz67ue@png",heroImageUrl:null,categorySlugs:$R[333]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[334]=[]},$R[335]={id:"22cb171f-79cf-4429-b549-c7e88995d0aa",name:"Open Trough",slug:"open-trough--9b0ffee8",tagline:"You Control Your Attention",description:"Open Trough pulls in your Bluesky feeds, blends them together, lets you tune the algorithm to your taste, and measure where your attention goes.\n\nSee the demo at https://opentrough.com/demo",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:o74ygkdgaqpqpcphx6pbs2tb/bafkreib2niurzf7q3bap4sugte67sg7irc2a2xxcwppcqtp2vtqwvmyjsa@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:o74ygkdgaqpqpcphx6pbs2tb/bafkreidvaltvd6sqwueueufm7scnmwjgluiaizutviwc6e2n6i5qnf7peu@png",categorySlugs:$R[336]=["apps/bluesky/feed-generators"],categorySlug:"apps/bluesky/feed-generators",category:"Bluesky Feed Generators",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"open-trough.bsky.social",appTags:$R[337]=[]},$R[338]={id:"d1268e6c-97f0-477a-b265-26601e728216",name:"ThunderSky",slug:"thundersky",tagline:"Alternative front page for Bluesky, inspired by Hacker News",description:"ThunderSky is an alternative front page for Bluesky, inspired by Hacker News. It surfaces the most engaged-with content from across the network, helping you discover interesting posts you might have missed.ThunderSky connects to Bluesky's Jetstream Firehose, processing thousands of posts and interactions in real-time. Posts are ranked using an algorithm that considers:Like countReply countRepost countPost age (newer posts rank higher)Account size (smaller accounts get a slight boost)",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreih5g4ivkklvau5kgrqff6yecw6ykqur4fbd6k6vh44bczqz4rynza@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiangs4px3rp4ez73kubnn3hij2dklfj3irlniwj2km6fkwko7wrsm@png",categorySlugs:$R[339]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[340]=[]},$R[341]={id:"d2b32750-4bac-463b-81da-1b836488190f",name:"TheBlueReport",slug:"thebluereport",tagline:"The top links on Bluesky, updated hourly",description:"The Blue Report is a website that shows trending links on Bluesky over the previous 24 hours. Links are scored based on the number of posts, reposts, and likes that reference them.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidfgirssplkduqfincaln4kqctoibcff2n247mwx6pzdn4jx65vaa@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiczzcromul5t7omg4u2bu75qb44wrbids6euw3tryvoijoulbptau@jpeg",categorySlugs:$R[342]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"theblue.report",appTags:$R[343]=[]},$R[344]={id:"47811c5f-b151-48b5-bb24-6c8b99072021",name:"TheBlue.social",slug:"theblue-social",tagline:"We offer a few tools to improve your Bluesky experience",description:"* Discover who follows you but you don't follow back. Easily manage your connections and build meaningful relationships on Bluesky.* Jump-start your Bluesky experience with curated lists of interesting accounts to follow. Find communities and content that match your interests. Find Bluesky starter packs you are not included in.* Discover who you are following who don't follow back. Easily manage your connections and build meaningful relationships by finding and managing non-mutual follows on Bluesky.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifcaeagnwbdn4mr3vtnicypu4cwhuyyxmu3bfuyqa6agkn6d7izlm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicbx2ldjhrjoiaytqgmzxfy3h2acvgjgshr35ggfwkuavxzieo25m@png",categorySlugs:$R[345]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"theblue.social",appTags:$R[346]=[]},$R[347]={id:"9434f008-40fa-48df-8a74-4ca586ff3898",name:"Swiper",slug:"swiper",tagline:"Grow Your Bluesky Community, One Swipe at a Time",description:"Following new people on Bluesky shouldn't be a shot in the dark. With Swiper.blue, simply swipe to connect with accounts and posts that genuinely interest you.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiasej45w3xqzrvljgx5k3xb43jdq2gh2uwgi2l3h7k2zxwq2k4qgq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreialhjxybwlkgr2b6ybw5kbdjlq3eedgvrqqvuzxzqnqkpyxokflri@png",categorySlugs:$R[348]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"swiper.blue",appTags:$R[349]=[]},$R[350]={id:"b6a93637-09b1-447a-ae58-82f19e3b6793",name:"Swat",slug:"swat",tagline:"Plan and publish your content",description:"Manage content, interact with your target group and grow together with your community on Bluesky.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiease24mydibru4kve7rpuwugp27hjrcbxzqk62nyrtmr6hbv2gqy@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibd63ocpjhklieloq5oi27tdshgx3joumbb3sqwnhd4of4dk4u4xm@jpeg",categorySlugs:$R[351]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"swat.io",appTags:$R[352]=[]},$R[353]={id:"4f431319-b193-4149-88ca-533855c8ef41",name:"SocialRails",slug:"socialrails",tagline:"Create content, post everywhere",description:"With SocialRails you can create content, and post to 9 social media platforms in seconds.Why does it stand out from other schedulers:- Better UX- Mobile Friendly- AI Assistant you can ask anything- Ability to generate short-form videos- Ability to generate GPT5 images- Ability to generate carousels, slideshows- Ability to generate pinterest pins- Ability to generate content ideas for your business- Cheaper when you need to connect a lot of accounts- Auto-optimize posts for each platform with one click- Auto-resizes & adjusts your images- Schedule to X communities- Schedule Threaded posts",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreids74wcuoybsokisfcazvkfnielmihlv5d2zedf6552lmjt3j7viy@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifbv67f3npoikzguosvkiaofrkh32kvyco4tremohzryzdsamj7su@png",categorySlugs:$R[354]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"socialrails.bsky.social",appTags:$R[355]=[]},$R[356]={id:"8a2a0e52-2ed7-4c9e-9181-0163be263e60",name:"Skymark",slug:"skymark",tagline:"Bookmark companion web app and feed for Bluesky",description:"Save posts privately by DMing them to @skymark.me. Your bookmarks are stored in a personal feed only you can access.Organize your collection by adding comma-separated tags in your message. Browse and manage all your saved content by signing into https://skymark.me with your Bluesky account.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihvgzrgaqqaibyhd6yesshneigx5b3rejp4el6ijk52qi6h6du4qa@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigxi2pbx4o5ttkptp7z4mdcalazgtq2lgw5zibfx6dpxpdczwtnem@png",categorySlugs:$R[357]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skymark.me",appTags:$R[358]=[]},$R[359]={id:"024f1f0a-6588-4e7c-b758-a184618cb47d",name:"Skyflow",slug:"skyflow",tagline:"Unlock your Bluesky network intelligence",description:"Your Bluesky Observatory.Track viral posts, measure creator impact, and unlock valuable engagement insights. Free forever. Built for Bluesky.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiahalbnlnfhnoudq3soq3ns5e5rexukmgntc222oatbejkdt7theu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifvc7oqyda2tdydtgkzq2c4h674juscby2tqh3ukcmjawrrq4fe5m@png",categorySlugs:$R[360]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skyflow.me",appTags:$R[361]=[]},$R[362]={id:"2554b587-9268-4b89-9d63-6c8849231a93",name:"SkyBeMoreBlue",slug:"skybemoreblue",tagline:"An AT Protocol app for Bluesky user introductions.",description:"SkyBeMoreBlue makes Bluesky more lively with introductions by others, helping people discover relevant accounts through warm recommendations and tags.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreic3cpyclkjnl7yaapjbvycvq6bemerf6g3gxomcqlzsgiwmew7rue@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid5orinogz4xynur32gna55nfyox7qyqofj2dlcdqgfp6ll5anoky@jpeg",categorySlugs:$R[363]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skybemoreblue.com",appTags:$R[364]=[]},$R[365]={id:"6dc45f39-2394-412a-94f0-f43e3e90df20",name:"Sky Follower Bridge",slug:"sky-follower-bridge",tagline:"Instantly find and follow the same users from your Twitter follows on Bluesky.",description:"Seamlessly migrate your social connections to Bluesky from  X, Threads, Facebook, and more.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiflbqkyzzreoqbb7yix4zk5ghrmxxlblj7gykvvdm2uuncxdgruba@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihes6svtfanhsm3rsnp3w54w6h4pkvlmgp6hez526gyrmft3xtr2e@png",categorySlugs:$R[366]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"sky-follower-bridge.dev",appTags:$R[367]=[]},$R[368]={id:"9b218f9d-20bc-4b6a-82ac-aa5de7863ae4",name:"SchedPilot",slug:"schedpilot",tagline:"a social media scheduler that supports bluesky",description:"SchedPilot is an AI-powered social media management platform designed to simplify cross-platform publishing by integrating emerging networks like Bluesky alongside mainstays such as X, LinkedIn, and TikTok. The tool moves beyond simple automation by offering an AI Pilot assistant that crafts platform-specific captions and suggests optimal posting times based on audience engagement data. With a visual drag-and-drop calendar, SchedPilot allows users to \"create once and post everywhere,\" ensuring that 300-character \"skeets\" are formatted correctly with images and hashtags while maintaining a consistent brand voice across the decentralized web.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidsuemgbjq3fmrxlwe4ad6inchxaipu4xr4asksnqg4tzp4dnnyj4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicy5mtd3jvb4rp4whahxhp4up5dtynpp6gjwfzxreqgmc56aztqaa@png",categorySlugs:$R[369]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"schedpilot.bsky.social",appTags:$R[370]=[]},$R[371]={id:"230c26fd-fcbe-41a9-9764-9003d15f11fb",name:"RPSync",slug:"rpsync",tagline:"Gather your online presence stats in a small local database.",description:"RPSync is your personal, privacy-first command center for social media analytics. Run this application locally to collect, visualize, and own your statistics from Bluesky, Instagram, TikTok, YouTube, Discord, and more.Key Features100% Local & Private: Your data stays on your machine.Unified Dashboard: Quickly Visualize your posts on the simple dashboard.Data Ownership: Export seamlessly to NocoDB or CSV.Free & Open Source: No subscriptions, no hidden fees.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidxwbbfcpfty5wxxka47gwtlqjzlhuqt7jq3paxix5jqfnfu35rzm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifzrcoqpaitfvi6tlwshlkgw57k6h2bv3zyaj5begwil7thktu6lu@png",categorySlugs:$R[372]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[373]=[]},$R[374]={id:"5879033c-1f15-4b38-a79f-f3a351df5d8f",name:"QRSurge.com",slug:"qrsurge-com",tagline:"Generate a QR code for your Bluesky profile",description:"Generate a QR code for your Bluesky profile and share it everywhere. Easily connect with followers and grow your Bluesky community.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidoj3pasezxosz7gbe5xi3pfiqwtpikmcolkhsjr42qppcdopzdle@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiandp7bsisvypr3zr2z4fwh2vznb3uqejorwtj2nwiqttzfdq5vwe@png",categorySlugs:$R[375]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"qrsurge.com",appTags:$R[376]=[]},$R[377]={id:"1b72ca20-5d35-40bf-9839-b582d61106e5",name:"Postpone",slug:"postpone",tagline:"Post scheduler & analytics to grow your audience on Bluesky (and beyond!)",description:"Plan and schedule your Bluesky posts and threads, auto-repost, organize your content, measure performance, and grow your audience with the #1 Bluesky scheduler for content creators.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihy2zwdkvbibh3jqwerpr4wdi5ow2xe7oub2amby5al3su3ybhxa4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidkeqelwddmxp7ipk4bqdevcaitdt3ypzc66meza47ls23daydtdy@jpeg",categorySlugs:$R[378]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"postpone.app",appTags:$R[379]=[]},$R[380]={id:"e4425d36-b656-40d8-a1f5-f0a6688698ff",name:"Posthyve",slug:"posthyve",tagline:"Your new favorite all-in-one content calendar & publishing platform!",description:"Introducing PostHyve, the ultimate all-in-one social media management platform designed to streamline your online presence. With PostHyve, effortlessly schedule and publish content across multiple platforms from a single, intuitive dashboard. Leverage AI-powered tools to generate engaging content and optimize posting times for maximum audience engagement. Gain valuable insights with advanced analytics to track performance and growth. Whether you're a creator, a small team, or an agency, PostHyve offers tailored solutions to elevate your social media strategy.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreib2iod6l4vbuig74xkqlqs35hteffkelty5zuza6s35g5w62is3se@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreib4qjfvtwu5opzrceohscfj3fbmieimtkxluih3izuq3ekimrlfkm@png",categorySlugs:$R[381]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[382]=[]},$R[383]={id:"6be06631-4b06-4426-8ae8-4664948c0f37",name:"TOKIMEKI",slug:"tokimeki",tagline:"TOKIMEKI is a Bluesky browser client with multi-column and multi-account support.",description:"TOKIMEKI is a Bluesky browser client with multi-column and multi-account support.\n\nIt is PWA compliant and can be used like an app on mobile devices.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigbbe2wwgnzp5gkamxqnmox6fdxezmongckruq2t4nk6e3n3crc3i@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiagxdcibzwfkfbx3isidt3hqqgfnvsu5pqv2zfpv2duubejsitgva@jpeg",categorySlugs:$R[384]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"tokimeki.blue",appTags:$R[385]=[]},$R[386]={id:"edb560c4-af3b-4530-ac93-21e1463d57a3",name:"Longpost",slug:"longpost",tagline:"Share beautiful code snippets",description:"Share beautiful code snippets along with the post text. Paste in your long thread into the client along with your code snippets and the client will automatically convert the code snippets into images with syntax highlighting. It will also split your text into multiple posts, if it exceeds the character limit.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiec74fzvu4sobczfcwma3c6c7msra6ix6vpa7dvvisqy6w5mtrodq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifbekqmrime5r4sqv2cdeez6sncaxipgrxf5cbw3seaxgpkk4stje@png",categorySlugs:$R[387]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[388]=[]},$R[389]={id:"d98a91d9-0ee7-453c-92e8-af5a07962257",name:"longer.blue",slug:"longer-blue",tagline:"Create longer posts on Bluesky",description:"Break free from character limits. Share longer posts on Bluesky while keeping the native feel and easy sharing you love.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieexhkkryawe3dejszz4wdsxpzbyghu34vgx4uicty7cjvjlzunly@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigbpbyinezrpthuhrc5fzwc352zfarcx2w72suoqpfkm3ynpuwjoa@png",categorySlugs:$R[390]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[391]=[]},$R[392]={id:"70d86e88-6aef-42c6-8e3f-5b3c85454ff9",name:"livingbio.blue",slug:"livingbio-blue",tagline:"Automations that update your profile based on custom triggers",description:"livingbio.blue is a tool that enables you to place dynamic and reactive placeholders in your Bluesky profile.By using placeholders (referred to as \"pots\") in your bio template, you can set up automatic updates based on various triggers through integration with automation platforms.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigb7tliycun2dqsrivxtjql6wclarknfx7my3unfvh2bqncasxbmq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihot2zojyeabaefrzul6zh47k3xfgsngime7m7cp2aoi42re3mate@png",categorySlugs:$R[393]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"livingbio.blue",appTags:$R[394]=[]},$R[395]={id:"7d857199-a591-4cac-8865-c8762cc172e1",name:"Klearsky",slug:"klearsky",tagline:"Streamlined Design, Maximum Control",description:"Klearsky is a dedicated web client for Bluesky and the AT Protocol.It features a friendly single-column layout while boasting one of the richest feature sets among all clients. Packed with custom tools and enhancements, Klearsky is the perfect choice for those who want to dive deeper into the Bluesky experience.KlearskyはBluesky/ATProtocol専用のWebクライアントです。親しみやすいシングルカラムレイアウトながら、全クライアント中トップレベルの機能数を誇ります。また、数々のカスタム機能をそろえており、Blueskyをより深く楽しみたい方に特におすすめします。",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreic6uaqbmyiqw3hffcgxm5ton3lmsae5ywycqla22bhktma6zd5uoa@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicgnoxsul6toobyjv6oyaljvkx6paqzbcfnnbr5fsgomvhcu6euya@png",categorySlugs:$R[396]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[397]=[]},$R[398]={id:"15794378-2822-4419-96d9-137caf56fad5",name:"ilo.so",slug:"ilo-so",tagline:"All of your internet stats",description:"Create a link-in-bio page. Add all of your links. Go live in minutes.Embed dynamic content and display real-time stats.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiepcfhyzq3bn5uodenswfr6jh5p2aeowh3ajgy45apcovehkhplsa@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaflv3r5jtqirv6lk2l2fyxo5f46vh4bozjdh6ofcs5v64suhx3qm@png",categorySlugs:$R[399]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"ilo.so",appTags:$R[400]=[]},$R[401]={id:"f00a661f-0e4f-41ed-8965-8e458b7a1aed",name:"Fedica",slug:"fedica",tagline:"Schedule to Bluesky, grow with deep analytics, find friends, and analyze audiences in one place.",description:"Fedica combines publishing, analytics, follower management, and account research in one place, including top interactors, follower quality audits, and account timeline analysis.You can schedule posts, threads, and videos, spread thread posts over time, crosspost to multiple platforms in one click, and customize content per network. It also includes practical publishing features like content labels, alt-text support, RSS automation, link cards, and content pipelines.On the analytics side, Fedica goes beyond basic metrics with post performance, follower growth and unfollower tracking, engagement trends, content/campaign filtering, and top engager insights. You can also analyze audience quality and demographics (age, gender, occupation, interests), spot fake/low-quality followers, and monitor account activity patterns.For discovery and growth, Fedica includes bio search, advanced follower filtering, timeline/account analysis, follower overlap analysis, list management, and top interactor tools,  helping you find the right people, understand your audience, and build stronger communities around your content.Fedica also includes 10 free scheduled posts at any time, poll scheduling, bulk upload to drafts + calendar, follow/unfollow tracking, and tools to manage both followers and accounts you follow",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieufp5s2jwnx3lus7yjmu75evie5cfnwbninb7syzrt7qmulojjuq@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaezbqb7ndjsdsvc7j3ucuifrvazequaxycd5pc7oxgf3jwm6b5vi@png",categorySlugs:$R[402]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"handle.invalid",appTags:$R[403]=[]},$R[404]={id:"32276205-5e1e-4a3b-8d3b-f5504af1a59d",name:"cred.blue",slug:"cred-blue",tagline:"Bluesky account credibility score",description:"Generate a Bluesky credibility score. Understand your AT Proto data footprint. Vibe check strangers and new accounts.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibcmlmj6lisi4imguxlnwegcb5rsshrivet5tzazftzggp4zo4d3i@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiahlijb7mktupsa6ngzeipbbsowzmpc6zcaz3mewaelxpa4kqcymm@png",categorySlugs:$R[405]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"cred.blue",appTags:$R[406]=[]},$R[407]={id:"2a28da5d-9d92-4a1d-8cfa-76612d721318",name:"Couch Sky",slug:"couch-sky",tagline:"Browse the Bluesky social network, from the comfort of your couch, on your Google or Amazon TVs & streaming devices.",description:"Browse and contribute to Bluesky from your television or streaming device.Follow users, pin feeds, like posts, and create new posts, all from your television, using a standard remote.Available for Android TV, Google TV, and Amazon Fire devices.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiemwvkf3zhloaqgpfvpjandnbvtln4m3lnu7hmpviujuwbtvoigne@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidcm67l7odekvmcega3vojdlytglqzjxckmyzeuzrgfv5jiokgfti@png",categorySlugs:$R[408]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[409]=[]},$R[410]={id:"57df9706-4eae-433d-a85d-2647ffe1dc8d",name:"Comment Picker",slug:"comment-picker",tagline:"Download Bluesky followers, follows, reposts, feed posts or post likes along with user details and statistics to Excel or CSV. Try for free!",description:"GiveawaysInstagram Comment PickerFacebook Comment PickerYouTube Comment PickerTikTok Comment PickerX (Twitter) PickerFacebook & Instagram Giveaway PickerRandom Name PickerWheel of NamesEntry Form GiveawayThreads Comment PickerBluesky Comment PickerReddit Comment PickerAll Giveaway Picker Tools >\n\nFacebook & Instagram Giveaway Picker\n\nInstagramInstagram Comment PickerExport Instagram CommentsFacebook & Instagram Giveaway PickerCreate Instagram GiveawayExport Instagram Ad CommentsExport Instagram PostsInstagram Hashtag Generator [AI]Instagram User ID FinderAll Instagram Tools >",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreienseqyhchxdhunjq52h4sg7gfmipukvunk7u22wwdrp5ufplryna@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieurf5uvcseef562wst3p4yooc6v25rrskah3a6aiyzv3ypq6pr44@webp",categorySlugs:$R[411]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"commentpicker.com",appTags:$R[412]=[]},$R[413]={id:"daed7e6b-9f76-4a93-b337-5405b385b5a0",name:"ClearSky",slug:"clearsky",tagline:"ClearSky - Bringing information closer to you",description:"If you've found Clearsky helpful, please consider supporting us. Your contribution helps keep Clearsky running and allows us to make improvements for the community.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifgj4of6jnesekennntsmctl63khmdmo5vubkadoji255iw6na7tm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreic3lld65gl27t4du6uzvbjvnqaon5ka5ugxwwn5c6elqfhrp5zrmm@webp",categorySlugs:$R[414]=["apps/bluesky/moderation"],categorySlug:"apps/bluesky/moderation",category:"Bluesky Moderation",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"clearsky.app",appTags:$R[415]=[]},$R[416]={id:"c3e15cb3-62e6-4403-8a9b-5ecd53a0b448",name:"Chavatar",slug:"chavatar",tagline:"Automatically rotate your Bluesky avatar.",description:"Chavatar is a Bluesky utility that automatically rotates your profile avatar so you can keep your identity fresh without manual uploads. It is aimed at people who want lightweight profile personalization with a simple, focused workflow.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiar7cuoldz74ju4tzwo4ucavvkj66h54cbh2rphrc7mwfndcunv2u@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihkeo4gqwexjhetbujobkfgtzwutpndkjmjcxl3lmqgaztiqhnqry@png",categorySlugs:$R[417]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"chavatar.app",appTags:$R[418]=[]},$R[419]={id:"7365ea08-4135-4dad-80c5-00dfc55fe05e",name:"Byesky",slug:"byesky",tagline:"Clean-up your Bluesky account",description:"Byesky helps you manage your Bluesky subscriptions by cleaning up non-mutual follows, saying goodbye to all your subscriptions, identifying your true friends and locking users you want to continue following.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiggsqmtvizwj3sbexcs5dsw7czhff3z4kb5vxbv5l6vpnrrhvyone@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidrqaj5syhmuwde34b6zpw2vgumwmaocty3xelxwnoygntwdv7cym@png",categorySlugs:$R[420]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"byesky.pirhoo.com",appTags:$R[421]=[]},$R[422]={id:"0c7d10f4-f576-42a9-9860-2e36e5084e56",name:"Buffer",slug:"buffer",tagline:"Find your flock on Bluesky",description:"It’s time to own your content and audience on decentralized social media. Easily build your community on Bluesky and beyond with Buffer’s flexible planning, posting, and analytics tools.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifmsvl6d7nrilrssvvdarnf7r5mis3r6mr7kom42elmfnjxbvdkvu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreienelvosb3rufteeurcyjgg3e5cibronfygjz3p2n6ezbq25tndqi@png",categorySlugs:$R[423]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"buffer.com",appTags:$R[424]=[]},$R[425]={id:"e737f550-e05e-404a-a618-09bf1f37599e",name:"Botwatch",slug:"botwatch",tagline:"Fight bots with shared bot and trust scores.",description:"Botwatch is a trust and anti-bot app where people flag suspected bot accounts, verify humans, and publish trust scores others can evaluate. It is built to make moderation and reputation signals transparent and verifiable so communities can decide who to trust.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifc67hzfzpydk72p2oyaqwffzqhtmitwgev7l6v7vda446mkdniiu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreih7am5anvbs2j3z7loope7kulr7p3gw4urgrty7sc57effcwfcfcy@jpeg",categorySlugs:$R[426]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"botwatch.net",appTags:$R[427]=[]},$R[428]={id:"0055fb98-8790-4204-9122-3ab14160e1e6",name:"Bonsai",slug:"bonsai--2772f996",tagline:"Take control of your timeline. Build your own algorithm.",description:"Bonsai is a research system that replaces \"black-box\" engagement models with intentional, natural language-based curation.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreia34jqta6tntlt6l7jdpm2n5yvrkdaqqyo7gnhi2hkgzjpriv2mum@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihihf5jau5uugclcghqxgwk5dpwzfl5kgk6fxtrkhxdgtlli2pfam@png",categorySlugs:$R[429]=["apps/bluesky/feed-generators"],categorySlug:"apps/bluesky/feed-generators",category:"Bluesky Feed Generators",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"getbonsai.bsky.social",appTags:$R[430]=[]},$R[431]={id:"f775c7dc-0b63-46f4-a762-8bdbf4ed976d",name:"bluetails",slug:"bluetails",tagline:"View Bluesky profile details",description:"bluetails allows you to view details about a Bluesky profile - including likes, blocks and lists.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihx4drfxa5rxof55cu6xgjdmm4m5qqvguuwtbagixuvxv52yhygii@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiauhtb2y5jyyr4zbjugloridau7luhazrdu7q7gcobocyr3g7va7a@png",categorySlugs:$R[432]=["apps/bluesky/moderation"],categorySlug:"apps/bluesky/moderation",category:"Bluesky Moderation",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bluetails.app",appTags:$R[433]=[]},$R[434]={id:"b2e4e9ec-a4cb-48fa-92f1-3c85dcb96e55",name:"BlueskyTimeline",slug:"blueskytimeline",tagline:"Embedded timeline widget for Bluesky Code snippet",description:"Insert this code where you want it to appear on your site\n\n*The height and width sizes are not reflected in the preview.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiawdozu2stldb3g5q5mdjhdua7lg4q3thtippprjbrvvxiemk46zy@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiagsc2dzfp2uoppcnstnznghvl57dlwo73dvzuxuzguet25munsiu@png",categorySlugs:$R[435]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[436]=[]},$R[437]={id:"12c463a0-ed7f-4fa8-b631-94f4813f4e2a",name:"BlueskyRoast",slug:"blueskyroast",tagline:"Discover Your Bluesky Digital Persona",description:"Let our AI analyze your posts, roast your takes, and reveal what your posting history says about you).",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibkgyvo4sb6rjwqxw3ahwl6jscqsi5bwvdc6teeeeksj2aiipeqja@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibyfolr5xvgl66izyzhbvfqngrpdfj56rztz4d76wp35vngon4cue@png",categorySlugs:$R[438]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"blueskyroast.bsky.social",appTags:$R[439]=[]},$R[440]={id:"057192cd-7727-4029-86d5-08ba9d3a3434",name:"Blueskyhunter",slug:"blueskyhunter",tagline:"Get the all-in-one, AI-powered Bluesky growth tool.",description:"Trusted by creators and businesses to schedule posts, track growth, and engage faster\n\nBlueskyhunter helps you finding what's currently popular, so you can grow faster and easier.Stay ahead by tracking trending topics in real time — discover what’s working for others, join relevant conversations, and boost your visibility when it matters most.\n\nWhether it’s basic analytics or in-depth reporting, Blueskyhunter will help you learn what works and how to improve. Track your performance, understand your audience, and make smarter decisions with clear, actionable insights.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreice2yot7qth2jyxvdahliye6yc2muewlqrm525gjtbrniln2ydgze@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihyhjtsc72owumuned2kjp4yhmbc6bg2p4xybjuiynj33ynhz3t3e@png",categorySlugs:$R[441]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"blueskyhunter.bsky.social",appTags:$R[442]=[]},$R[443]={id:"1c0c25ae-900a-443b-b9b2-cd1714c28068",name:"Bluesky Video Downloader",slug:"bluesky-video-downloader",tagline:"Download High-Quality Videos, GIFs, and Images from Bluesky",description:"Bluesky Video Downloader is a free tool that allows you to download videos from Bluesky with their original quality. This tool also works with images and GIFs.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidtovhqvqhv3hbaqqt6bygasaxmdzmakpvatcioph46xgw3yjlvv4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiexdgemdm2wrfamc6yvqzk35iceq626aa5iynu3oo2rvb46ais564@png",categorySlugs:$R[444]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bluecrawler.com",appTags:$R[445]=[]},$R[446]={id:"980c8be5-289e-439f-ac84-c072d1b653bb",name:"Bluesky Trends and Insights",slug:"bluesky-trends-and-insights",tagline:"Discover interesting people and trends on Bluesky",description:"Get insights into the world of BlueSky, including the most followed users, trending users, follower recommendations.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiafgxrwvkkm3dhod7ut6pyd3bwilt2yrdtmvoniduj2arcnlldupu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifebf5qmnot6si4zwnnntw6hhb7crurvpg6xdaqrsi5bj56q6z4ia@png",categorySlugs:$R[447]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bluefacts.app",appTags:$R[448]=[]},$R[449]={id:"bf21cc52-dc39-4a0a-a626-cd0f7b4d31fd",name:"Bluesky Tracker",slug:"bluesky-tracker",tagline:"follower tracker, bulk unfollow",description:"Manage Your Bluesky Network Like a ProTrack followers, identify ghost followers, and manage your network with powerful analytics. Get comprehensive insights into your Bluesky connections in one place.Batch ManagementEfficiently manage your connections with powerful batch follow/unfollow tools. Clean up your network and manage your connections with ease.Ghost Follower DetectionIdentify inactive followers and analyze engagement patterns. Get insights into who's actually engaging with your content.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifptjl5i6qzk5drxomyzpnuuumh4xv4ncecnqz4wai54oi4m3x6dy@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreic2hhyotzd36ligd3ivccr4n5pfrk432ddtl55zhbhjp6v3efxboe@png",categorySlugs:$R[450]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[451]=[]},$R[452]={id:"ca214a29-5828-4778-be14-249cb58b73da",name:"Bluesky Replies Exporter",slug:"bluesky-replies-exporter",tagline:"extract post's replies from Bluesky",description:"Export Bluesky Post Replies with EaseEasily export replies from any Bluesky post to CSV, Excel, or JSON. Perfect for content creators and community managers to analyze discussions and track conversations.Everything you need to analyze Bluesky post repliesExport and analyze replies to your Bluesky posts with our comprehensive toolsetPost Replies ExportExport replies from any Bluesky post to CSV, Excel, or JSON format. Understand who's responding to your content and analyze the conversations.Thread AnalysisAnalyze replies in threaded conversations. Track discussion flow and identify key participants in your threads.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreig55zned3ehsvldsj2i6qpsjrxasp4f5jvss4x2qob3hxfurcgi5e@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidgqgnztw42xweex2eocgc6ufgegckxokklbdrwd4jnpdni332hry@png",categorySlugs:$R[453]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[454]=[]},$R[455]={id:"40189112-b890-4998-b0be-b252aad9b5ca",name:"Bluesky Pulse",slug:"bluesky-pulse",tagline:"Get detailed insights about your Bluesky posts, followers, and engagement.",description:"See exactly which posts land, when your audience is active, and how your following has grown — for any public Bluesky account.\n\nBuilt specifically for Bluesky — not a generic social media dashboard\n\nEnter any public Bluesky handle and get a full analytics report in seconds\n\nAnalyze your own account or research any other public Bluesky profile — creators, brands, or people you follow.\n\nData is fetched directly from Bluesky on every visit — no stale snapshots or cached dashboards to worry about.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihufcezpgu7nzo3hjkm4d7zrsuiq4ylprhndfekicdbrtzdiy3hju@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidb7opi5eu3rczptw46tmapdipkhn6gnlnziyolrdowkvz6vsb4tq@png",categorySlugs:$R[456]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[457]=[]},$R[458]={id:"ec98494f-914c-4ab0-aa41-d835f0be6535",name:"Bluesky Post Screenshot Maker",slug:"bluesky-post-screenshot-maker",tagline:"Easily turn any Bluesky post into a stunning, shareable image with our Bluesky Screenshot Generator.",description:"Bluesky is the lobby to the open web. Find and build your community here.\n\nEasily turn any Bluesky post into a stunning, shareable image with our Bluesky Screenshot Generator. Perfect for crossposting to other social media platforms.\n\nJust discovered postspark.app tool for creating beautiful screenshots for all sorts of things. It's perfect 😍\n\nAwesome tool to generate converting screenshots\n\nThis is a crazy tool, why didn’t anyone tell me about it?",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiewsjlanwg2ndtlnb3smlknkvubokgwtvftgpakdiuwmnn7pypemu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidbowrfo2xo7qfswcxf7k6gpbupqbxmb2svy5ad3zneoabic2scbu@png",categorySlugs:$R[459]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"postspark.app",appTags:$R[460]=[]},$R[461]={id:"bbfb5e16-1a3d-4fea-952a-3dbc5244f6de",name:"Bluesky Follow Exporter",slug:"bluesky-follow-exporter",tagline:"export bluesky followers and followings",description:"Export Bluesky Followers & Followings with EaseEffortlessly export any Bluesky user's followers and followings to CSV, Excel, or JSON. Simplify your social network analysis and data management.Following ExportExport any user's following list to CSV, Excel, or JSON format. Track who they are interested in and discover shared connections.Follower ExportExport complete follower lists to analyze your audience or any user's community. Perfect for social network analysis.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreic6cihq75oehghomwjvoxzd7hqdqscotc6nzz63g3r5bh2zxbh65a@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaydc4q67xgzu5cox4alfryso4tajsttcj6ln3hrmlahshbefds3a@png",categorySlugs:$R[462]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[463]=[]},$R[464]={id:"32569792-de6e-4dc7-9d42-1adc47ce3482",name:"Bluesky Alerts & Account Backup by Skyscraper",slug:"bluesky-alerts-and-account-backup-by-skyscraper",tagline:"Backup your Bluesky account and get notifications when keywords are posted to Bluesky",description:"Power tools for Bluesky. Get email alerts when keywords appear in posts, and create complete backups of any public account.Monitor keywords, hashtags, brand names, or phrases. Track up to 5 terms, and up to 25 usages of those terms a day. Premium plans available for more terms and tracking per day.Back up your own account or any public profile. Create up to 2 backups per day with 36-hour download links. Premium plans available for more backups per day. Download a full backup, including all posts, followers, and following lists.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreighb2pm2hc4eb5un42vw5jlawwujyed3yul7j6mmkkmuojbu45ugu@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibvgy74ci64k4r6cqur77s4wv2rffuzlpqhxuo7pm2f2z6klb3qva@png",categorySlugs:$R[465]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[466]=[]},$R[467]={id:"036ea2c4-810c-420f-821c-473cc7d77450",name:"Bluejeans",slug:"bluejeans",tagline:"Liberals Gain Seat on Wisconsin Supreme Court, Adding to Firewall in Voting Cases - Bolts",description:"Tuesday morning, in a social media post, the President of the United States signaled his intent to violate the rules of war, which prohibit targeting civilians.\n\nVoters in Wisconsin ensured on Tuesday that the supreme court in one of the nation’s premier swing states will be controlled by liberals through at least 2030. Chris Taylor, a... Read More",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihsjq3yam5jx776nhijz7k6bsh5kn4q7hjexu7nvf26hfmida7uby@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicxfjimozcfwzxgjwyj2g2debarj3vaiphvw2eewxpx76tbhp3qta@png",categorySlugs:$R[468]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"bluejeans.app",appTags:$R[469]=[]},$R[470]={id:"af117aff-ee62-4712-abaa-bb4b5cbfef18",name:"BlueCatalog",slug:"bluecatalog",tagline:"Search through your Bluesky likes and bookmarks easily",description:"Client-side app to easily search through your Bluesky likes and bookmarks.Features pagination and search.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigesgy3r4kstjuoalxx5kxlcqxj6aovirwpe2es434xdhq5elxi2y@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreienbbr726hv74cdlpz67uy6kjlerxmqrqv26djhnitmwhsf7fwcqa@png",categorySlugs:$R[471]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[472]=[]},$R[473]={id:"59e4c629-a927-4f92-a85b-312884185b67",name:"Best Time to Post",slug:"best-time-to-post",tagline:"Find the optimal time to post based on your followers' activity",description:"Understanding when your audience is most engaged, is crucial to increase your chances of reaching them and catch their attention.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieqhukitmgxflcbaqbjgmrzpnafgb4ueanxtp5tjenuee6mcbjche@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreighpzatyzddwdz45vplap4b2c52s6s4p4x36afcgk6lh2hpws5i34@png",categorySlugs:$R[474]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[475]=[]},$R[476]={id:"70635247-8d43-4018-9e6e-904c7aa6fe97",name:"Beeskie",slug:"beeskie",tagline:"A Bluesky client for Windows",description:"Beeskie is a third-party client for Bluesky, a microblogging social media platform. Pronounced like \"bee-ski\", this app is free and open source, and it's built natively for Windows to maximize performance and match the Windows design language.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidxwbbfcpfty5wxxka47gwtlqjzlhuqt7jq3paxix5jqfnfu35rzm@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreic73jhgkhvsqhqcirqzgzp24r3ylp4u6v66vp7xbp7qpizzw3hcau@png",categorySlugs:$R[477]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[478]=[]},$R[479]={id:"7d0d6d50-b25e-4f87-a034-ae67840adf91",name:"Attie",slug:"attie--071d66ac",tagline:"Your feed. Your focus. Just talk.",description:"Describe what you want to see and watch your feed compose itself around you.\n\nInformation is everywhere. Attention is scattered. Attie helps you focus on what matters.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifud7ea2tydjocschhnpeljm5mpi4xwcqo4xd22k2klv4jmpvh37q@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreibhlixk5cqdjtatdftfvvzumy6m7velrjrfrljp77zjr6lz7dbw7m@jpeg",categorySlugs:$R[480]=["apps/bluesky/feed-generators"],categorySlug:"apps/bluesky/feed-generators",category:"Bluesky Feed Generators",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"attie.ai",appTags:$R[481]=[]},$R[482]={id:"86c16215-a489-4f6c-9b41-91e9672f4e79",name:"Atsky",slug:"atsky",tagline:"Explore what's new around your sky today",description:"Open-source livestreaming on the AT Protocol\n\nExplore apps to enhance your experience\n\nVisited Zion National Park for the first time - impossible to convey how beautiful it is\n\nNature will remind you that you were never broken Only momentarily forgotten… #landscape #mountains #nature #photographersofbluesky #eck #photography #imageandverse #scape #victoria #photographersunited\n\nthis is my nephew's homework and i'm gonna cry",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicchxl3xms2a4x2yyijbceg6id445olsimw7ytxqbd5l2tnasotz4@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid5syspyvfgwhapdydvavs7cznamg7hoalu7oys5qge4zazcjtnim@jpeg",categorySlugs:$R[483]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"atsky.app",appTags:$R[484]=[]},$R[485]={id:"b8f30453-355e-490e-b06f-34f5df723a3f",name:"Realtime Bluesky Metrics",slug:"realtime-bluesky-metrics",tagline:"Track your Bluesky profile growth in real-time.",description:"Unlock real-time insights into your Bluesky Social profile! Track your follower count, post activity, and the people you're following with Realtime.blue's seamless, live experience.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigj57womdtgqkvpn7o4sbscgqpbpksgaawz7a55zmlmfve34atree@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreie23wyko52azmcbcl3q7jhqclxaw4vvtvs24m4rlzf3irj4fxnje4@png",categorySlugs:$R[486]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"realtime.blue",appTags:$R[487]=[]},$R[488]={id:"710c621a-7604-41e8-a57d-579e17ae5250",name:"Bluesky Inbox",slug:"bluesky-inbox",tagline:"Be the first in the conversation with real-time Bluesky keyword and author tracking.",description:"Bluesky Inbox is a browser-based keyword tracker that respects your privacy. No servers, no costly subscriptions, no artificially imposed limits.It is:100% private - your data stays in your browser100% unlimited - track as many keywords as you want100% anonymous - you don't need to sign in to Bluesky Inbox or Bluesky itselfIt gives you:Instant matches direct from the Bluesky firehoseAn email inbox-like interfaceThe tools to stay organised and jump into conversations before anyone else",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid344lfrwnwjw62hcbkgbobfs7pddcjhaefuu3kbqcoqwcdtmwrwy@png",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiazkzd7hrcpnkriwnmprbfinzpbrh6ggpruvprdtl24xf7tbv5rqq@png",categorySlugs:$R[489]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"blueskyinbox.com",appTags:$R[490]=[]},$R[491]={id:"4233ed6d-377f-462e-a576-ba4f31c78a05",name:"Chronosky",slug:"chronosky",tagline:"Schedule your Bluesky posts with ease.",description:"Chronosky is a Bluesky scheduling app for planning, scheduling, and publishing posts when your audience is most engaged, with support for rich media, link card previews, flexible timezone-aware scheduling, and multilingual workflows.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:bfjib7fy6dob3gyfssyfd4ry/bafkreieognr7p4zzmbhso4w72w664joatdim5ooeib3pl5t32ofn4mdieu@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:bfjib7fy6dob3gyfssyfd4ry/bafkreiafyx65jpbo5n2wdcdxpyqdnz2tdxmamx7u6iw5ooubwgags5ugge@png",categorySlugs:$R[492]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"chronosky.app",appTags:$R[493]=[]},$R[494]={id:"ab3bb797-c5bd-4097-95a5-057de1ee0476",name:"UnfollowPack",slug:"unfollowpack",tagline:"Unfollow a StarterPack in one click",description:"UnfollowPack is a simple tool that let's you unfollow a StarterPack in one click. useful for cases for those regretful \"follow all\" clicks You simply login -> submit the link to the StarterPack -> you get the list of users composing it along with how many of them you're following and the option to unfollow them all or one by one.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigfoholfl2pfcggrh6lrcb3njwbtipg6xum5u4mof4mmcxfctvcl4@jpeg",heroImageUrl:null,categorySlugs:$R[495]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[496]=[]},$R[497]={id:"e3db8cff-2607-42bf-8f30-8ae1e0f66873",name:"TwitPane",slug:"twitpane",tagline:"Android SNS client with Bluesky, Mastodon & Misskey support",description:"TwitPane started as a third-party client for Twitter, but that's not available anymore. Instead, it can now be used with Bluesky, Mastodon, and Misskey accounts! It has full support for all of Bluesky's features, minus labeler settings and a couple others.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiheup5iwmxssi4xs6xv6icnnewkpmn5xm3vtvin6ffjboy5rq5kuq@jpeg",heroImageUrl:null,categorySlugs:$R[498]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[499]=[]},$R[500]={id:"a565cab2-f349-4acc-8cb7-f067e71f59b3",name:"Thread2Page",slug:"thread2page",tagline:"MVP Development and Bluesky Thread Converter Tools",description:"Thread2Page transforms Bluesky threads into clean, readable web pages. This tool makes it easy to share and view threaded conversations in a more accessible format outside of the Bluesky platform.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreicncbafwmhzlqbynyqxxjdwaulwwm5o25wogzb2mgi2twyc3jg47y@jpeg",heroImageUrl:null,categorySlugs:$R[501]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[502]=[]},$R[503]={id:"c0f77969-d047-45e2-a829-24fcb0c77abd",name:"Skyminder",slug:"skyminder",tagline:"Bluesky Social Audience Management",description:"Designed with simplicity and functionality in mind, Skyminder empowers users to take control of their follower interactions and audience engagement in a more user-friendly interface.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifz43n7i6kijb6w3xo6nrzued7wjmlsm5plslfnzf7es4wbuqudzy@jpeg",heroImageUrl:null,categorySlugs:$R[504]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"skyminder.app",appTags:$R[505]=[]},$R[506]={id:"659c4cae-026a-4d86-b63d-b16b85e091eb",name:"Quiet Posters",slug:"quiet-posters",tagline:"List of your follows sorted by least active",description:"Bluesky Quiet Posters is your go-to tool for spotting the quietest accounts in your feed! It helps you uncover which connections are basically ghosting your timeline by tracking their posting habits. The result? A handy ranked list showing who’s been MIA in your feed!",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiedvemyv35er2vokgcmhqyqr5svn3ie2gs4wvg6llzak65xadc7ei@jpeg",heroImageUrl:null,categorySlugs:$R[507]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[508]=[]},$R[509]={id:"1770af6b-916c-41c0-bd15-1fd219a01860",name:"Cerulean",slug:"cerulean",tagline:"A lightweight native Bluesky client for power users. Supports Windows 95/98 - 11",description:"Cerulean is a great client for Bluesky (still in beta stage, though) that is:lightweight (uses around 40MB of ram, 20MB if not including images from posts), native (C# and WinForms)compact (detailed, efficient and feature-packed user interface for power users)and compatible (supports Windows 95 with the .NET backport, Windows 98 to 11 natively).This is the only client out there that caters to power users with its compact interface while also being able to run on an OS below Windows 10.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreids3izg3tfwb75b75uz4s7ltaugsmkuwyahknzd2l2zw5ii4ububa@jpeg",heroImageUrl:null,categorySlugs:$R[510]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"ceruleanweb.neocities.org",appTags:$R[511]=[]},$R[512]={id:"bf29e7d9-9ded-4f70-8a8c-44ac981d3a9c",name:"booksky",slug:"booksky",tagline:"a bluesky client for bookworms",description:"Booksky is an alternative Bluesky client specifically designed for book lovers. It provides a specialized interface for browsing and engaging with book-related content on the Bluesky social network.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigzt2n53eqz2xrk34a43p6fkusc3fsndxvgrk7rks4vub55mhz32a@png",heroImageUrl:null,categorySlugs:$R[513]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"booksky.app",appTags:$R[514]=[]},$R[515]={id:"08105775-ed44-4f6c-a3cd-7cfa27e9d436",name:"Bluesky Counter",slug:"bluesky-counter",tagline:"Marc Köhlbrugge's Bluesky profile stats and follower analytics",description:"🚧 Building blueskycounter.com wip.co betalist.com roomai.com startup.jobs m-u-l-t-i-v-e-r-s-e.com handle.horse submit.co and more.\n\nWant to see detailed stats about your own follower growth over time? Connect your Bluesky account to get started.\n\nTrack your daily new followers, total growth, and more.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreiaf5do7foaslz2aohxvfe4noucgsrub7miszutgxkcwp6aenqc26y@jpeg",heroImageUrl:null,categorySlugs:$R[516]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[517]=[]},$R[518]={id:"f6a78286-848a-4b86-99bd-6cb9a2b7271d",name:"Bluesky Copilot",slug:"bluesky-copilot",tagline:"Bluesky Copilot: Tailored AI Content based on your Bluesky Profile.",description:"AI Generations Expired for Today. Unlock more 1000 AI Generations left today Login\n\nAI-powered insights and suggestions for your Bluesky profile.\n\nAI-generated suggestions based on your posting history and writing style Powered by yourgenlab.com\n\nDiscover when your high-performing posts were published\n\nEnhance your Bluesky experience with our advanced tools and analytics\n\nSee which people you follow don't follow you back. Get insights into your one-sided connections and manage your network better.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreictjvbs6sdeacwvcvkokuy24utycpwipq5fbi7q6skvapzo7ijshu@jpeg",heroImageUrl:null,categorySlugs:$R[519]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[520]=[]},$R[521]={id:"25ac1e78-021c-4abe-b2a4-afab8caa3743",name:"Blue Pilot",slug:"blue-pilot",tagline:"Build & Grow Your Bluesky Audience",description:"Get real, relevant followers with BluePilot. Understand, engage, and grow your community efficiently with recommended actions and curated accounts",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigfxixffbpqvnq2pz7g42mu7qpjxcn2ap55xypgww3kfl4s4bdf3m@jpeg",heroImageUrl:null,categorySlugs:$R[522]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"blue-pilot.bsky.social",appTags:$R[523]=[]},$R[524]={id:"56e00ee1-3f0f-4946-b939-84f99d45ba83",name:"PostFlow",slug:"postflow",tagline:"Schedule & manage your 🦋 Bluesky content",description:"Schedule your content in one place, watch it appear everywhere.⏰ Post scheduling Schedule your social media content weeks ahead. All platforms, one simple tool.📅 Content planning Plan content and visualize your social media strategy in intuitive calendar and other views.👥 CollaborationCollaborate with your team and clients in the perfect flow. Unlimited seats, for free.✅ ApprovalsApprove content with feedback and live preview before publishing. Easy approvals.📊 AnalyticsUnderstand what your audience likes with data. Detailed metrics and insights.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreieiekgxdck7lojaqa6huwzice46aippwzlxyeasul5vgp6sw2wuhq@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreia54s5pdx3oab6xigwctvizylbb2skaqsmuj5ocgm3lbmgwqe4h7m@png",categorySlugs:$R[525]=["apps/bluesky/scheduling"],categorySlug:"apps/bluesky/scheduling",category:"Bluesky Scheduling",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"postflow.app",appTags:$R[526]=[]},$R[527]={id:"bdc2b89e-bfd0-4406-baec-43305dd397fc",name:"Graysky",slug:"graysky",tagline:"A 3rd party Bluesky client that's absolutely jam-packed with features.",description:"Primarily developed by Samuel, Graysky is an open source client for Android and iOS.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigzmv6fg6g6uzog7zzxyiakepcc4vdyht2qnmnczr5ealntvu4zhm@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigdg4soq2mm4rvnycdlc43itluffuiaihgqdqdivgrg2z62s3c2pi@png",categorySlugs:$R[528]=["apps/bluesky/client"],categorySlug:"apps/bluesky/client",category:"Bluesky Client",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"graysky.app",appTags:$R[529]=[]},$R[530]={id:"bc781551-fc98-4a1e-8a09-2fd8e7e598d7",name:"Follow Blue",slug:"follow-blue",tagline:"Grow your Bluesky audience effortlessly - get real and targeted followers for your business.",description:"Smart FollowingFollow Blue is a Bluesky growth tool that categorizes, filters, and finds the most attractive accounts to build your audience. A smart way to increase your Bluesky followers.Targeted Bluesky FollowersIt's good to have a large audience on Bluesky but, it's even better to have an active and targeted audience to engage with. Don't waste time with spam/fake accounts. Get real and targeted Bluesky followers for your brand.Audience on budgetBuilding your Bluesky audience hasn't to be expensive. Save money while growing your audience. Our Bluesky follow bot is the most thrifty way to get targeted Bluesky followers.Auto UnfollowFollow Blue takes care of the cleanup of your account. It will automatically identify non-followers accounts previously followed by Follow Blue and will unfollow them to keep your followers/following ratio healthy.Compounded GrowthThe compound effect of daily actions is the key to steady and non-stop growth for your account. Trust the consistency and persistence of our Bluesky growth service to grow.Growth AnalyticsTrack your growth with detailed analytics and adjust your strategy for optimal results.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifv4ad2gpi3h357rpsicxedjxn4vardz54wgnlhobqukgwavoz5wa@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigjlkvhznehdiz6tlesnx5thkh4bukcqfcas42swglkxrhw5eb4ky@png",categorySlugs:$R[531]=["apps/bluesky/analytics"],categorySlug:"apps/bluesky/analytics",category:"Bluesky Analytics",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:"followblue.app",appTags:$R[532]=[]},$R[533]={id:"a47eb352-82d3-4acd-9692-d34d5d20a681",name:"bskysrch",slug:"bskysrch",tagline:"Advanced search tool for Bluesky with support for phrases, users, time periods, languages, domains and hashtags.",description:"Will search for posts with phrase: \"\"\n\nWill search for posts with domain:\n\nWill search for posts in lang:\n\nFill in the fields you want to search. A search query will be generated and you'll be taken straight to the results on Bluesky. It's like an advanced search for Bluesky. You can search for phrases, usernames, time periods, languages, domains, and hashtags. All fields are based on Bluesky's native search operators.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreid6qflphnmqqbf7fqpawklxriwuulmrodqi6mcg6vpwhnx7xcw7qm@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreidaghwnol5tworf7mijai7ubmf5ky65plhw4zvdovj62333xeme5q@png",categorySlugs:$R[534]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[535]=[]},$R[536]={id:"4c603729-a9ee-4f69-be6d-881af1bc5a21",name:"bsky.md",slug:"bsky-md",tagline:"Fetch public Bluesky profiles, posts, feeds, and search results as clean Markdown via simple HTTP endpoints.",description:"bsky.md turns public Bluesky data into clean Markdown without authentication or API keys. It provides endpoints for profiles, posts, threads, feeds, likes, followers, following, search, links, and trending topics, making it useful for developers, automation, and coding agents.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreifruc5jc4jvn66h55wd5egvz5kduswoybpu7ojz4hv5cml6gbj6bm@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihx33pljzjhg35jrwhlcqctnaghtmpu5y5vp7elshh6ihqwlmle4i@png",categorySlugs:$R[537]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[538]=[]},$R[539]={id:"c70adba2-340a-446e-83b5-30094312a5e4",name:"BskyDelete",slug:"bskydelete",tagline:"Mass delete Bluesky posts, reposts, likes and bulk unfollow users.",description:"Mass delete Bluesky posts, reposts, likes and bulk unfollow users. Advanced filtering to delete Bluesky content by date, engagement, keywords. Clean your Bluesky account efficiently.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreigrazzn7gqgyotcxo3kcqg7fzglqrfofbcqhwjgahukwen3a4qzlm@jpeg",heroImageUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4php4s5b457d/bafkreihf66cii6iixusfyolrfl3os2cv5u62adb4flk7umrift54vhntze@png",categorySlugs:$R[540]=["apps/bluesky/tool"],categorySlug:"apps/bluesky/tool",category:"Bluesky Tool",accent:"green",rating:null,reviewCount:0,priceLabel:"GET",productAccountHandle:null,appTags:$R[541]=[]},$R[542]={id:"16c9e35a-f991-49ec-956e-d6ec53d090f9",name:"Blusky Apps",slug:"blusky-apps",tagline:"Post your App Changelogs automatically to Bluesky",description:"Blusky Apps is a tool that allows you to post your App (iOS) Changelogs automatically to a Bluesky Account.",iconUrl:"https://cdn.bsky.app/img/feed_fullsize/plain/did:plc:dvy6bdnofdfc4ph